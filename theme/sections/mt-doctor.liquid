    },
    {
      "type": "text",
      "id": "signoff_brand",
      "label": "Brand name",
      "default": "MARCEL OMR Therapy"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
