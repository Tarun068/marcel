    },
    {
      "type": "text",
      "id": "member",
      "label": "Line beside the role tag",
      "info": "For example: First Member of the OSMF Specialist Doctor Community."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name"
    },
    {
      "type": "text",
      "id": "qualification",
      "label": "Qualification"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "About the doctor"
    },
    {
      "type": "textarea",
      "id": "points",
      "label": "Key points",
      "info": "Optional. One per line."
    },
    {
      "type": "text",
      "id": "clinic",
      "label": "Clinic"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Town and state"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Phone label",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "phone",
