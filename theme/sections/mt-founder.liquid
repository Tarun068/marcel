{%- style -%}
  .mt-founder { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(28px, 5vw, 80px); align-items: center; }
  .mt-founder--reverse > .mt-founder-photo { order: 2; }
  .mt-founder-photo { position: relative; aspect-ratio: 4 / 4.8; border-radius: var(--mt-r-xl); overflow: hidden; background: var(--mt-tint); }
  .mt-founder-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mt-founder-fallback { position: absolute; inset: 0; display: grid; place-items: center; color: var(--mt-on-dark); }
  .mt-founder-fallback svg { width: 34%; height: auto; opacity: .9; }
  .mt-founder-tag { position: absolute; left: 16px; bottom: 16px; right: 16px; display: grid; gap: 2px; width: fit-content; padding: 12px 16px; border-radius: 14px; background: var(--mt-paper); border: 1px solid var(--mt-line); }
  .mt-founder-tag b { font-size: 15.5px; color: var(--mt-ink); line-height: 1.25; }
  .mt-founder-tag small { font-size: 13px; color: var(--mt-ink-3); }
  .mt-founder-copy { display: grid; gap: 20px; align-content: center; }
  .mt-founder-quote { position: relative; font-size: var(--mt-fs-sub); font-weight: 700; line-height: 1.32; letter-spacing: -.015em; color: var(--mt-ink); }
  .mt-founder-quote::before { content: "\201C"; display: block; height: 36px; font-size: 72px; line-height: .9; font-weight: 800; color: var(--mt-aqua); }
  .mt-founder-rule { display: block; height: 1px; background: var(--mt-line); }
  .mt .mt-founder-copy .mt-h3 { font-size: var(--mt-fs-sub); }
  .mt .mt-founder-copy .mt-h2 { font-size: var(--mt-fs-h); }
  .mt-founder-copy > .mt-eyebrow + h2 { margin-top: -10px; }
  .mt-founder-body > * + * { margin-top: 14px; }
  .mt-founder-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 26px; }
  .mt-founder-fact { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 2px 12px; align-items: start; }
  .mt-founder-fact .mt-i { grid-row: span 2; width: 26px; height: 26px; color: var(--mt-teal); stroke-width: 1.7; }
  .mt-founder-fact b { color: var(--mt-ink); font-size: 16px; line-height: 1.3; }
  .mt-founder-fact span { font-size: 14.5px; line-height: 1.45; }
  @media (max-width: 920px) {
    .mt-founder { grid-template-columns: minmax(0, 1fr); }
    .mt-founder--reverse > .mt-founder-photo { order: 0; }
    .mt-founder-photo { max-width: 460px; aspect-ratio: 4 / 4; }
    .mt-founder-photo--empty { aspect-ratio: auto; max-width: none; background: none; overflow: visible; }
    .mt-founder-photo--empty .mt-founder-fallback { display: none; }
    .mt-founder-photo--empty .mt-founder-tag { position: static; }
    .mt-founder-photo--empty { order: 2; }
  }
  @media (max-width: 480px) {
    .mt-founder-facts { grid-template-columns: minmax(0, 1fr); }
  }
{%- endstyle -%}

{%- liquid
  assign link = section.settings.link | default: routes.root_url
-%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-founder-sec' %}">
  <div class="mt-wrap mt-founder{% if section.settings.quote_position == 'right' %} mt-founder--reverse{% endif %}">
    <figure class="mt-founder-photo{% if section.settings.photo == blank %} mt-founder-photo--empty{% endif %}">
      {%- if section.settings.photo != blank -%}
        {{ section.settings.photo | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.name, sizes: '(min-width: 990px) 40vw, 92vw', widths: '400, 600, 800, 1000' }}
      {%- else -%}
        <span class="mt-founder-fallback" aria-hidden="true">
          <svg viewBox="0 0 48 48"><use href="#mt-logo-mark"/></svg>
        </span>
      {%- endif -%}
      {%- if section.settings.name != blank -%}
        <figcaption class="mt-founder-tag">
          <b>{{ section.settings.name | escape }}</b>
          {%- if section.settings.role != blank -%}<small>{{ section.settings.role | escape }}</small>{%- endif -%}
        </figcaption>
      {%- endif -%}
    </figure>

    <div class="mt-founder-copy">
      {%- if section.settings.quote_eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.quote_eyebrow | escape }}</span>{%- endif -%}
      {%- if section.settings.quote != blank -%}
        <blockquote class="mt-founder-quote">{{ section.settings.quote | escape }}</blockquote>
      {%- endif -%}
      <span class="mt-founder-rule" aria-hidden="true"></span>
      {%- if section.settings.story_eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.story_eyebrow | escape }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="{% if section.settings.heading_size == 'large' %}mt-h2{% else %}mt-h3{% endif %}">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="mt-rte mt-founder-body">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="mt-founder-facts">
          {%- for block in section.blocks -%}
            <li class="mt-founder-fact" {{ block.shopify_attributes }}>
              {%- render 'mt-icon', icon: block.settings.icon -%}
              <b>{{ block.settings.title | escape }}</b>
              {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <p>
          <a class="mt-link" href="{{ link }}">
            {{- section.settings.link_label | escape -}}
            {%- render 'mt-icon', icon: 'arrow-right' -%}
          </a>
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

