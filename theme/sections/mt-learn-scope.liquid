{{ 'mt-learn.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  What this approach is and is not (OMR Therapy page, client reference 2026-11-21): a heading and up to four
  cards. Each card has a coloured header with a green tick, red cross, amber warning or teal note, and up to
  four lines, each with its own icon. Every word is live text; the soft waves are optional.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign cols = section.blocks.size
  if cols > 4
    assign cols = 4
  endif
  assign extra = 'mt-lx mt-scope'
  if s.waves
    assign extra = extra | append: ' mt-scope--waves'
  endif
-%}
<section class="{% render 'mt-section-class', s: s, extra: extra %}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="mt-wrap">
    {%- render 'mt-learn-head', eyebrow: s.eyebrow, heading: s.heading, text: s.text, mark: s.heading_mark -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mt-scope-grid mt-scope-grid--{{ cols }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            case b.style
              when 'no'
                assign sign = 'x'
              when 'caution'
                assign sign = 'warn-solid'
              when 'info'
                assign sign = 'info'
              else
                assign sign = 'check'
            endcase
          -%}
          <div class="mt-scope-card mt-scope-card--{{ b.style }}" {{ block.shopify_attributes }}>
            <div class="mt-scope-head">
              <span class="mt-scope-badge">{%- render 'mt-icon', icon: sign -%}</span>
              {%- if b.title != blank -%}<h3 class="mt-h3 mt-scope-title">{{ b.title | escape }}</h3>{%- endif -%}
            </div>
            {%- capture lines -%}
              {%- for n in (1..4) -%}
                {%- assign text_key = 'text_' | append: n -%}
                {%- assign icon_key = 'icon_' | append: n -%}
                {%- if b[text_key] != blank -%}
                  <li{% if b[icon_key] == 'none' %} class="is-plain"{% endif %}>
                    {%- if b[icon_key] != 'none' -%}<span class="mt-scope-ico">{%- render 'mt-icon', icon: b[icon_key] -%}</span>{%- endif -%}
                    <span class="mt-scope-text">{{ b[text_key] | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if lines != blank -%}<ul class="mt-scope-list">{{ lines }}</ul>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.note != blank -%}<p class="mt-fine mt-scope-note">{{ s.note }}</p>{%- endif -%}
  </div>
</section>

