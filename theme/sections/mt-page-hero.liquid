{{ 'mt-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fallback_title = page.title | default: collection.title | default: blog.title | default: shop.name
  assign current = section.settings.current_label | default: fallback_title
  assign stats = section.blocks | where: 'type', 'stat'
  assign searches = section.blocks | where: 'type', 'search'
  assign art = section.settings.art | default: 'none'
  assign has_media = false
  if section.settings.image != blank
    assign has_media = true
  elsif art != 'none'
    assign has_media = true
  endif
  assign hero_text = section.settings.text
  if hero_text == blank and collection.description != blank
    assign hero_text = collection.description | strip_html | truncatewords: 40
  endif
-%}
{%- capture btn1_link -%}{% render 'mt-link-to', key: section.settings.button_1_to, url: section.settings.button_1_link %}{%- endcapture -%}
{%- capture btn2_link -%}{% render 'mt-link-to', key: section.settings.button_2_to, url: section.settings.button_2_link %}{%- endcapture -%}
{%- capture back_link -%}{% render 'mt-link-to', key: section.settings.back_to, url: section.settings.back_link %}{%- endcapture -%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-phero' %}{% if section.settings.align == 'center' and has_media == false %} mt-phero--center{% endif %}">
  <div class="mt-wrap{% if has_media %} mt-phero-grid mt-phero--media{% elsif stats.size > 0 %} mt-phero-grid{% endif %}">
    <div class="mt-phero-copy">
      {%- if section.settings.show_crumbs -%}
        <nav class="mt-crumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a>
          {%- if section.settings.parent_label != blank -%}
            {%- render 'mt-icon', icon: 'chevron-right' -%}
            <a href="{{ section.settings.parent_link | default: routes.root_url }}">{{ section.settings.parent_label | escape }}</a>
          {%- endif -%}
          {%- render 'mt-icon', icon: 'chevron-right' -%}
          <span aria-current="page">{{ current | escape }}</span>
        </nav>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h1 class="mt-h1">{{ section.settings.heading | default: fallback_title }}</h1>
      {%- if hero_text != blank -%}
        <p class="mt-lead">{{ hero_text }}</p>
      {%- endif -%}
      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="mt-btn-row mt-phero-btns">
          {%- if section.settings.button_1_label != blank -%}
            <a class="mt-btn mt-btn-primary" href="{{ btn1_link }}"{% if section.settings.button_1_to == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.button_1_label | escape }}{%- render 'mt-icon', icon: 'arrow-right' -%}</a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a class="mt-btn mt-btn-secondary" href="{{ btn2_link }}"{% if section.settings.button_2_to == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.button_2_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.note != blank -%}<p class="mt-fine mt-phero-note">{{ section.settings.note }}</p>{%- endif -%}
      {%- if section.settings.back_label != blank -%}
        <a class="mt-link mt-phero-back" href="{{ back_link }}">{%- render 'mt-icon', icon: 'arrow-left' -%}{{ section.settings.back_label | escape }}</a>
      {%- endif -%}
      {%- for block in searches -%}
        <form class="mt-find-form" action="{{ block.settings.link | default: request.path }}" method="get" role="search" data-mt-search-form {{ block.shopify_attributes }}>
          <label class="mt-search-box">
            {%- render 'mt-icon', icon: block.settings.icon -%}
            <span class="visually-hidden">{{ block.settings.placeholder | escape }}</span>
            <input type="search" name="{{ block.settings.param | default: 'q' }}" placeholder="{{ block.settings.placeholder | escape }}" autocomplete="off">
          </label>
          <button class="mt-btn mt-btn-primary" type="submit">{{ block.settings.button_label | escape }}</button>
        </form>
      {%- endfor -%}
      {%- if has_media and stats.size > 0 -%}
        {%- comment -%} With a photo on the right, the stats sit under the text. {%- endcomment -%}
        <div class="mt-phero-stats mt-phero-stats--row">
          {%- for block in stats -%}
            <div class="mt-phero-stat" {{ block.shopify_attributes }}>
              <b>
                {%- if block.settings.value != blank -%}
                  {{- block.settings.value | escape -}}
                {%- else -%}
                  {%- render 'mt-icon', icon: block.settings.icon -%}
                {%- endif -%}
              </b>
              <span>{{ block.settings.label | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- if has_media -%}
      <div class="mt-phero-media{% if section.settings.image == blank %} mt-phero-media--art{% endif %}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 520px, 92vw', widths: '400, 600, 800, 1200', alt: section.settings.image.alt
          }}
        {%- else -%}
          <img
            src="{{ 'mt-art-' | append: art | append: '-560.webp' | asset_url }}"
            srcset="{{ 'mt-art-' | append: art | append: '-560.webp' | asset_url }} 560w, {{ 'mt-art-' | append: art | append: '.webp' | asset_url }} 1120w"
            sizes="(min-width: 990px) 520px, 92vw"
            width="1120"
            height="920"
            alt=""
            fetchpriority="high"
          >
        {%- endif -%}
      </div>
    {%- elsif stats.size > 0 -%}
      <div class="mt-phero-stats">
        {%- for block in stats -%}
          <div class="mt-phero-stat" {{ block.shopify_attributes }}>
            <b>
              {%- if block.settings.value != blank -%}
                {{- block.settings.value | escape -}}
              {%- else -%}
                {%- render 'mt-icon', icon: block.settings.icon -%}
              {%- endif -%}
            </b>
            <span>{{ block.settings.label | escape }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

