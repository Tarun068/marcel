{{ 'mt-pages.css' | asset_url | stylesheet_tag }}
{{ 'mt-article.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign chapters = section.blocks | where: 'type', 'chapter'
  assign has_toc = false
  if section.settings.show_toc and chapters.size > 1
    assign has_toc = true
  endif
  # A video beside the text (not with the page contents list).
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign has_video = false
  if has_toc == false
    if video != blank or video_url != blank
      assign has_video = true
    endif
  endif
  assign video_kind = 'hosted'
  if video == blank
    assign video_kind = video_url.type
  endif
-%}
{%- if has_video -%}
  <script src="{{ 'mt-videos.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-guide' %}">
  <div class="mt-wrap{% if has_toc %} mt-guide-layout{% elsif has_video %} mt-guide-split{% endif %}">
    {%- if section.settings.show_toc and chapters.size > 1 -%}
      <nav class="mt-toc" aria-label="{{ section.settings.toc_title | escape }}">
        <b>{{ section.settings.toc_title | escape }}</b>
        {%- for block in chapters -%}
          {%- assign anchor = block.settings.anchor | default: block.id | handleize -%}
          <a href="#{{ anchor }}">{{ block.settings.toc_label | default: block.settings.heading | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="mt-prose">
      {%- liquid
        assign body = ''
        assign cards = ''
        assign attrs = ''
        assign head = ''
        assign started = false
      -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'card' and cards != blank -%}
          {%- capture body -%}{{ body }}<div class="mt-cards mt-cards--fill">{{ cards }}</div>{%- endcapture -%}
          {%- assign cards = '' -%}
        {%- endif -%}

        {%- if block.type == 'chapter' -%}
          {%- if started -%}
            <section class="mt-prose-sec" {{ attrs }}>{{ head }}{{ body }}</section>
          {%- endif -%}
          {%- liquid
            assign anchor = block.settings.anchor | default: block.id | handleize
            assign attrs = 'id="' | append: anchor | append: '" ' | append: block.shopify_attributes
            assign head = ''
            if block.settings.heading != blank
              assign head = '<h2>' | append: block.settings.heading | append: '</h2>'
            endif
            assign body = ''
            assign started = true
          -%}
        {%- else -%}
          {%- assign started = true -%}
          {%- capture item -%}
            {%- case block.type -%}
              {%- when 'text' -%}
                <div class="mt-rte mt-prose-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
    
              {%- when 'callout' -%}
                <div class="mt-callout{% if block.settings.style != 'info' %} mt-callout--{{ block.settings.style }}{% endif %}" {{ block.shopify_attributes }}>
                  {%- render 'mt-icon', icon: block.settings.icon -%}
                  <div class="mt-rte">{{ block.settings.text }}</div>
                </div>
    
              {%- when 'card' -%}
                <div class="mt-mini-card" {{ block.shopify_attributes }}>
                  {%- if section.settings.card_media == 'photo' -%}
                    {%- if block.settings.image != blank -%}
                      <span class="mt-card-photo">{{ block.settings.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180, 360', sizes: '88px', alt: '' }}</span>
                    {%- elsif block.settings.art != blank and block.settings.art != 'none' -%}
                      <span class="mt-card-photo"><img src="{{ 'mt-card-' | append: block.settings.art | append: '.webp' | asset_url }}" alt="" width="360" height="360" loading="lazy"></span>
                    {%- else -%}
                      <span class="mt-card-photo mt-card-photo--icon">{%- render 'mt-icon', icon: block.settings.icon -%}</span>
                    {%- endif -%}
                  {%- else -%}
                    {%- render 'mt-icon', icon: block.settings.icon -%}
                  {%- endif -%}
                  <b>{{ block.settings.title | escape }}</b>
                  {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
                </div>
    
              {%- when 'checklist' -%}
                {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
                <ul class="mt-checks{% if block.settings.columns == '2' %} mt-two-col{% endif %}" {{ block.shopify_attributes }}>
                  {%- for line in lines -%}
                    {%- assign item = line | strip -%}
                    {%- if item != blank -%}<li>{%- render 'mt-icon', icon: 'check' -%}<span>{{ item | escape }}</span></li>{%- endif -%}
                  {%- endfor -%}
                </ul>
    
              {%- when 'table' -%}
                {%- liquid
                  assign heads = block.settings.head | split: '|'
                  assign rows = block.settings.rows | newline_to_br | split: '<br />'
                -%}
                <div class="mt-table-wrap" {{ block.shopify_attributes }}>
                  <table class="mt-table">
                    <thead>
                      <tr>{%- for h in heads -%}<th scope="col">{{ h | strip | escape }}</th>{%- endfor -%}</tr>
                    </thead>
                    <tbody>
                      {%- for row in rows -%}
                        {%- assign cells = row | strip | split: '|' -%}
                        {%- if cells.size > 0 -%}
                          <tr>
                            {%- for cell in cells -%}
                              {%- assign value = cell | strip -%}
                              {%- comment -%} data-label: the column name, shown before the value when phones stack each row {%- endcomment -%}
                              {%- assign label = heads[forloop.index0] | strip | escape -%}
                              {%- if forloop.first and value contains '#' -%}
                                {%- assign parts = value | split: '#' -%}
                                <td data-label="{{ label }}"><span class="mt-stage-chip" style="--c: #{{ parts[1] | strip }};"><i></i>{{ parts[0] | strip | escape }}</span></td>
                              {%- elsif forloop.index == block.settings.bold_col -%}
                                <td class="mt-mmv" data-label="{{ label }}">{{ value | escape }}</td>
                              {%- else -%}
                                <td data-label="{{ label }}">{{ value | escape }}</td>
                              {%- endif -%}
                            {%- endfor -%}
                          </tr>
                        {%- endif -%}
                      {%- endfor -%}
                    </tbody>
                  </table>
                </div>
    
              {%- when 'link' -%}
                {%- if block.settings.label != blank -%}
                  <a class="mt-link" href="{{ block.settings.url | default: settings.mt_link_test | default: routes.root_url }}" {{ block.shopify_attributes }}>
                    {{- block.settings.label | escape -}}
                    {%- render 'mt-icon', icon: 'arrow-right' -%}
                  </a>
                {%- endif -%}
    
              {%- when 'fine' -%}
                <p class="mt-fine" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
    
              {%- when 'articles' -%}
                {%- assign guide = block.settings.blog | default: blogs['patient-guide'] | default: blogs.news -%}
                <div class="mt-art-grid" {{ block.shopify_attributes }}>
                  {%- for article in guide.articles limit: block.settings.limit -%}
                    {%- render 'mt-article-card', article: article, read_label: section.settings.read_label, show_image: block.settings.show_images, sizes: '(min-width: 990px) 300px, (min-width: 600px) 45vw, 92vw' -%}
                  {%- else -%}
                    <p class="mt-placeholder">{{ section.settings.no_articles | escape }}</p>
                  {%- endfor -%}
                </div>
            {%- endcase -%}
          {%- endcapture -%}
          {%- if block.type == 'card' -%}
            {%- capture cards -%}{{ cards }}{{ item }}{%- endcapture -%}
          {%- else -%}
            {%- capture body -%}{{ body }}{{ item }}{%- endcapture -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if cards != blank -%}
        {%- capture body -%}{{ body }}<div class="mt-cards mt-cards--fill">{{ cards }}</div>{%- endcapture -%}
      {%- endif -%}
      {%- if started -%}
        <section class="mt-prose-sec" {{ attrs }}>{{ head }}{{ body }}</section>
      {%- endif -%}
    </div>
    {%- if has_video -%}
      <div class="mt-guide-video{% if section.settings.video_shape == 'portrait' %} mt-guide-video--portrait{% endif %}">
        <mt-video data-kind="{{ video_kind }}"{% if video_kind != 'hosted' %} data-id="{{ video_url.id | escape }}"{% endif %} data-title="{{ section.settings.video_title | escape }}">
          {%- if section.settings.video_cover != blank -%}
            {{- section.settings.video_cover | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '480, 720, 1100', sizes: '(min-width: 990px) 45vw, 92vw', alt: '' -}}
          {%- elsif video_kind == 'hosted' and video.preview_image != blank -%}
            {{- video.preview_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '480, 720, 1100', sizes: '(min-width: 990px) 45vw, 92vw', alt: '' -}}
          {%- elsif video_kind == 'youtube' -%}
            {% # theme-check-disable-next-line RemoteAsset %}
            <img src="https://i.ytimg.com/vi/{{ video_url.id | escape }}/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
          {%- endif -%}
          {%- if video_kind == 'hosted' -%}
            <template>{{ video | video_tag: controls: true, autoplay: true, playsinline: true, preload: 'none' }}</template>
          {%- endif -%}
          <button type="button" class="mt-video-play" aria-label="{{ section.settings.video_title | default: 'Play video' | escape }}">
            <span><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12-7.5z"/></svg></span>
          </button>
        </mt-video>
      </div>
    {%- endif -%}
  </div>
</section>

