{{ 'mt-pd.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  How to use, from the client product page design: numbered steps on a dotted line, each in a card with an
  illustration, or a list of steps. A picture can sit above the steps (list layout: the steps sit under the picture in
  the same card); a second built-in picture sits beside the first at the same height, neither one cropped.
  In the step text, bold marks amounts and times and italic marks warnings (shown in red).
  A video can sit beside the steps (client's how-to videos, 2026-11-22; portrait 9:16 suits it best). It loads only
  when the visitor presses play, then plays with sound. Hosted videos show their length under the frame.
{%- endcomment -%}
{%- liquid
  assign padded = false
  if section.settings.number_style == 'padded'
    assign padded = true
  endif
  assign has_media = false
  if section.settings.media_image != blank or section.settings.media_art != 'none'
    assign has_media = true
  endif
  assign media_pair = false
  if has_media and section.settings.media_art_2 != 'none'
    assign media_pair = true
  endif
  # Built-in picture sizes (width / height); the close-up of the drops is 3:2, the others 4:3.
  assign m1_h = 900
  if section.settings.media_art == 'howto-orashield-drops'
    assign m1_h = 800
  endif
  assign m2_h = 900
  if section.settings.media_art_2 == 'howto-orashield-drops'
    assign m2_h = 800
  endif
  assign m1_ar = 1200.0 | divided_by: m1_h | round: 3
  assign m2_ar = 1200.0 | divided_by: m2_h | round: 3

  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign has_video = false
  if video != blank or video_url != blank
    assign has_video = true
  endif
  assign video_kind = 'hosted'
  if video == blank
    assign video_kind = video_url.type
  endif
  # Length as m:ss from the hosted video (duration is in milliseconds).
  assign video_len = ''
  if video_kind == 'hosted' and video.duration > 0
    assign len_total = video.duration | divided_by: 1000
    assign len_m = len_total | divided_by: 60
    assign len_s = len_total | modulo: 60
    if len_s < 10
      assign video_len = len_m | append: ':0' | append: len_s
    else
      assign video_len = len_m | append: ':' | append: len_s
    endif
  endif
-%}
{%- if has_video -%}
  <script src="{{ 'mt-videos.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- capture video_html -%}
  {%- if has_video -%}
    <figure class="mt-usevideo">
      <mt-video data-kind="{{ video_kind }}"{% if video_kind != 'hosted' %} data-id="{{ video_url.id | escape }}"{% endif %} data-title="{{ section.settings.video_title | escape }}">
        {%- if section.settings.video_cover != blank -%}
          {{- section.settings.video_cover | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '340px', alt: '' -}}
        {%- elsif video_kind == 'hosted' and video.preview_image != blank -%}
          {{- video.preview_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '340px', alt: '' -}}
        {%- elsif video_kind == 'youtube' -%}
          {% # theme-check-disable-next-line RemoteAsset %}
          <img src="https://i.ytimg.com/vi/{{ video_url.id | escape }}/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
        {%- endif -%}
        {%- if video_kind == 'hosted' -%}
          <template>{{ video | video_tag: controls: true, autoplay: true, playsinline: true, preload: 'none' }}</template>
        {%- endif -%}
        <button type="button" class="mt-video-play" aria-label="{{ section.settings.video_title | default: 'Play video' | escape }}">
          <span><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12-7.5z"/></svg></span>
        </button>
      </mt-video>
      {%- if section.settings.video_title != blank or video_len != blank or section.settings.video_note != blank -%}
        <figcaption>
          {%- if section.settings.video_title != blank -%}<b>{{ section.settings.video_title | escape }}</b>{%- endif -%}
          {%- if video_len != blank or section.settings.video_note != blank -%}
            <span class="mt-usevideo-tags">
              {%- if video_len != blank -%}<span>{%- render 'mt-icon', icon: 'clock' -%}{{ video_len }}</span>{%- endif -%}
              {%- if section.settings.video_note != blank -%}<span>{{ section.settings.video_note | escape }}</span>{%- endif -%}
            </span>
          {%- endif -%}
        </figcaption>
      {%- endif -%}
    </figure>
  {%- endif -%}
{%- endcapture -%}
{%- capture media_img -%}
  {%- if section.settings.media_image != blank -%}
    {%- assign up_ar = section.settings.media_image.aspect_ratio | round: 3 -%}
    {%- capture up_style -%}--ar: {{ up_ar }};{%- endcapture -%}
    {{ section.settings.media_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 1200px) 1100px, 94vw', alt: section.settings.media_image.alt, style: up_style }}
  {%- elsif section.settings.media_art != 'none' -%}
    <img src="{{ 'mt-' | append: section.settings.media_art | append: '.webp' | asset_url }}" alt="{{ section.settings.media_alt | escape }}" width="1200" height="{{ m1_h }}" style="--ar: {{ m1_ar }};" loading="lazy">
  {%- endif -%}
  {%- if media_pair -%}
    <img src="{{ 'mt-' | append: section.settings.media_art_2 | append: '.webp' | asset_url }}" alt="{{ section.settings.media_alt_2 | escape }}" width="1200" height="{{ m2_h }}" style="--ar: {{ m2_ar }};" loading="lazy">
  {%- endif -%}
{%- endcapture -%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-usesteps-sec' %}">
  <div class="mt-wrap">
    {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}
    {%- if section.settings.layout == 'list' -%}
      {%- if has_video -%}<div class="mt-usesteps-split">{%- endif -%}
      <div class="mt-usesteps-card">
        {%- if has_media -%}<figure class="mt-usesteps-figure{% if media_pair %} mt-usesteps-figure--pair{% endif %}">{{ media_img }}</figure>{%- endif -%}
        <ol class="mt-usesteps-list" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="mt-usesteps-mark{% if section.settings.list_mark == 'check' %} mt-usesteps-mark--check{% endif %}" aria-hidden="true">
                {%- if section.settings.list_mark == 'check' -%}{%- render 'mt-icon', icon: 'check' -%}{%- else -%}{% if padded and forloop.index < 10 %}0{% endif %}{{ forloop.index }}{%- endif -%}
              </span>
              <p>{% if block.settings.title != blank %}<b>{{ block.settings.title | escape }}</b> {% endif %}{{ block.settings.text }}</p>
            </li>
          {%- endfor -%}
        </ol>
      </div>
      {%- if has_video -%}{{ video_html }}</div>{%- endif -%}
    {%- else -%}
      {%- if has_media -%}<figure class="mt-usesteps-figure mt-usesteps-figure--solo{% if media_pair %} mt-usesteps-figure--pair{% endif %}">{{ media_img }}</figure>{%- endif -%}
      {%- if has_video -%}<div class="mt-usesteps-split mt-usesteps-split--cards">{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ol class="mt-usesteps" style="--n: {{ section.blocks.size }};">
          {%- for block in section.blocks -%}
            <li class="mt-usestep" {{ block.shopify_attributes }}>
              <span class="mt-usestep-n" aria-hidden="true">{% if padded and forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <div class="mt-usestep-card">
                {%- if block.settings.art != 'none' -%}
                  <span class="mt-usestep-art">{%- render 'mt-pd-art', art: block.settings.art -%}</span>
                {%- endif -%}
                <h3>{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
      {%- if has_video -%}{{ video_html }}</div>{%- endif -%}
    {%- endif -%}
    {%- if section.settings.note != blank -%}<p class="mt-usesteps-note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Marcel how to use",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "How to Use"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Follow the recommended directions for use:"
    },
    {
      "type": "inline_richtext",
      "id": "note",
      "label": "Note under the steps"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "cards",
          "label": "Cards in a row"
        },
        {
          "value": "list",
          "label": "List under the picture"
        }
      ],
      "default": "cards"
    },
    {
      "type": "select",
      "id": "number_style",
      "label": "Numbers",
      "options": [
        {
          "value": "plain",
          "label": "1, 2, 3"
        },
        {
          "value": "padded",
          "label": "01, 02, 03"
        }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "list_mark",
      "label": "List marker",
      "options": [
        {
          "value": "number",
          "label": "Number"
        },
        {
          "value": "check",
          "label": "Tick"
        }
      ],
      "default": "number"
    },
    {
      "type": "header",
      "content": "Picture"
    },
    {
      "type": "select",
      "id": "media_art",
      "label": "Built-in picture",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "howto-oracare",
          "label": "OraCare: 6 to 7 puffs guide"
        },
        {
          "value": "howto-orashield",
          "label": "OraShield: drops into water"
        },
        {
          "value": "howto-orashield-drops",
          "label": "OraShield: close-up of drops"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "media_image",
      "label": "Picture (upload)"
    },
    {
      "type": "text",
      "id": "media_alt",
      "label": "Picture description",
      "info": "For screen readers, used with the built-in picture."
    },
    {
      "type": "select",
      "id": "media_art_2",
      "label": "Second built-in picture",
      "info": "Shown beside the first picture at the same height.",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "howto-oracare",
          "label": "OraCare: 6 to 7 puffs guide"
        },
        {
          "value": "howto-orashield",
          "label": "OraShield: drops into water"
        },
        {
          "value": "howto-orashield-drops",
          "label": "OraShield: close-up of drops"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "media_alt_2",
      "label": "Second picture description"
    },
    {
      "type": "header",
      "content": "Video",
      "info": "Shown beside the steps on computers and under them on phones. Portrait 9:16 videos suit it best."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video uploaded to Shopify"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Or a YouTube or Vimeo link",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "image_picker",
      "id": "video_cover",
      "label": "Cover picture",
      "info": "Shown until the video is played. Empty uses the video's own preview frame."
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video caption",
      "info": "Shown under the video and read out by screen readers.",
      "default": "Watch the Video Guide"
    },
    {
      "type": "text",
      "id": "video_note",
      "label": "Note beside the length",
      "info": "Optional, for example In Hindi."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "paper",
          "label": "White"
        },
        {
          "value": "mist",
          "label": "Light"
        },
        {
          "value": "tint",
          "label": "Tinted"
        },
        {
          "value": "navy",
          "label": "Navy"
        }
      ],
      "default": "mist"
    },
    {
      "type": "checkbox",
      "id": "sheet",
      "label": "Rounded top edge",
      "info": "Overlaps the section above, like stacked sheets. Looks best when the background differs from the section above.",
      "default": false
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "tight",
          "label": "Compact"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "info": "Bold marks amounts and times. Italic marks a warning and shows in red."
        },
        {
          "type": "select",
          "id": "art",
          "label": "Illustration",
          "options": [
            {
              "value": "dilute",
              "label": "Drops into water"
            },
            {
              "value": "rinse",
              "label": "Rinse or gargle"
            },
            {
              "value": "spit",
              "label": "Spit out"
            },
            {
              "value": "repeat",
              "label": "Morning and night"
            },
            {
              "value": "spray",
              "label": "Oral spray"
            },
            {
              "value": "paste",
              "label": "Toothpaste"
            },
            {
              "value": "brush",
              "label": "Brushing"
            },
            {
              "value": "water",
              "label": "Glass of water"
            },
            {
              "value": "exercise",
              "label": "Mouth opening exercise"
            },
            {
              "value": "gentle",
              "label": "Gentle movement"
            },
            {
              "value": "clean",
              "label": "Clean"
            },
            {
              "value": "guide",
              "label": "Professional guidance"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marcel how to use",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Prepare",
            "art": "dilute"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Use",
            "art": "rinse"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Finish",
            "art": "spit"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Repeat",
            "art": "repeat"
          }
        }
      ]
    }
  ]
}
{% endschema %}
