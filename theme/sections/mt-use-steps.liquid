            {
              "value": "rinse",
              "label": "Rinse or gargle"
            },
            {
              "value": "spit",
              "label": "Spit out"
            },
            {
              "value": "repeat",
              "label": "Morning and night"
            },
            {
              "value": "spray",
              "label": "Oral spray"
            },
            {
              "value": "paste",
              "label": "Toothpaste"
            },
            {
              "value": "brush",
              "label": "Brushing"
            },
            {
              "value": "water",
              "label": "Glass of water"
            },
            {
              "value": "exercise",
              "label": "Mouth opening exercise"
            },
            {
              "value": "gentle",
              "label": "Gentle movement"
            },
            {
              "value": "clean",
              "label": "Clean"
            },
            {
              "value": "guide",
              "label": "Professional guidance"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "default": "none"
        }
      ]
