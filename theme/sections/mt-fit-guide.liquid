{{ 'mt-pd.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  "Honest guidance, is this right for you?" from the client REF pack: who it may suit (ticks) and when to get guidance
  first (arrows), two links and a note. Italic text in the heading shows in orange.
{%- endcomment -%}
{%- capture l1 -%}{% render 'mt-link-to', key: section.settings.link_1_to, url: section.settings.link_1 %}{%- endcapture -%}
{%- capture l2 -%}{% render 'mt-link-to', key: section.settings.link_2_to, url: section.settings.link_2 %}{%- endcapture -%}
{%- assign yes_items = section.settings.yes_items | newline_to_br | split: '<br />' -%}
{%- assign no_items = section.settings.no_items | newline_to_br | split: '<br />' -%}
<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-fit-sec' %}">
  <div class="mt-wrap">
    <div class="mt-fit-head">
      {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}
    </div>
    <div class="mt-fit">
      <div class="mt-fit-col mt-fit-col--yes">
        <p class="mt-fit-h">{%- render 'mt-icon', icon: 'check' -%}{{ section.settings.yes_title | escape }}</p>
        <ul role="list">{%- for t in yes_items -%}{%- assign t = t | strip -%}{%- if t != blank -%}<li>{%- render 'mt-icon', icon: 'check' -%}<span>{{ t | escape }}</span></li>{%- endif -%}{%- endfor -%}</ul>
      </div>
      <div class="mt-fit-col mt-fit-col--no">
        <p class="mt-fit-h">{%- render 'mt-icon', icon: 'arrow-right' -%}{{ section.settings.no_title | escape }}</p>
        <ul role="list">{%- for t in no_items -%}{%- assign t = t | strip -%}{%- if t != blank -%}<li>{%- render 'mt-icon', icon: 'arrow-right' -%}<span>{{ t | escape }}</span></li>{%- endif -%}{%- endfor -%}</ul>
        {%- if section.settings.link_1_label != blank or section.settings.link_2_label != blank -%}
          <div class="mt-fit-links">
            {%- if section.settings.link_1_label != blank -%}<a class="mt-btn mt-btn-primary mt-btn-sm" href="{{ l1 }}"{% if section.settings.link_1_to == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.link_1_label | escape }}</a>{%- endif -%}
            {%- if section.settings.link_2_label != blank -%}<a class="mt-btn mt-btn-secondary mt-btn-sm" href="{{ l2 }}"{% if section.settings.link_2_to == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.link_2_label | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.note != blank -%}<p class="mt-fit-note">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</section>

