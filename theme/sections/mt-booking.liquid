    },
    {
      "type": "text",
      "id": "prop_age",
      "label": "Age",
      "default": "Age"
    },
    {
      "type": "text",
      "id": "prop_phone",
      "label": "Phone",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "prop_email",
      "label": "Email",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "prop_address",
      "label": "Address",
      "default": "Address"
    },
    {
      "type": "text",
      "id": "prop_date",
      "label": "Date",
