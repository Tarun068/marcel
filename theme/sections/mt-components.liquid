{{ 'mt-pages.css' | asset_url | stylesheet_tag }}
{{ 'mt-products.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .mt-comps { display: grid; grid-template-columns: repeat(var(--mt-cols, 3), minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 960px) {
    .mt-comps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .mt-comps { grid-template-columns: minmax(0, 1fr); }
  }
  .mt-comp { display: flex; flex-direction: column; overflow: hidden; border-radius: var(--mt-r-xl); background: var(--mt-paper); border: 1px solid var(--mt-line); }
  .mt-bg-paper .mt-comp { background: var(--mt-mist); border-color: transparent; }
  .mt-comp-media { position: relative; display: block; aspect-ratio: 4 / 3; background: var(--mt-pack-bg); }
  .mt-comp-ico { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--mt-tint); color: var(--mt-teal); }
  .mt-comp-ico .mt-i { width: 56px; height: 56px; stroke-width: 1.3; }
  .mt-comp-badge { position: absolute; top: 14px; left: 14px; z-index: 2; padding: 5px 11px; border-radius: 99px; background: var(--mt-paper); font-size: 11.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--mt-ink); }
  .mt-comp-body { display: flex; flex-direction: column; gap: 10px; flex: 1; padding: 20px 22px 22px; }
  .mt .mt-comp h3 { font-size: var(--mt-fs-sub); line-height: 1.25; letter-spacing: -.01em; }
  .mt-comp-size { font-size: 14px; font-weight: 700; color: var(--mt-ink-3); }
  .mt-comp p { font-size: var(--mt-fs-body); line-height: 1.55; }
  .mt-comp-foot { margin-top: auto; padding-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
{%- endstyle -%}

{%- assign items = section.blocks | where: 'type', 'component' -%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-components' %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="mt-wrap">
    {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}
    <div class="mt-comps" style="--mt-cols: {{ section.settings.columns }};">
      {%- for block in items -%}
        {%- liquid
          assign p = block.settings.product
          if p == blank
            capture p_handle
              render 'mt-product-handle', art: block.settings.art, url: block.settings.link
            endcapture
            if p_handle != blank
              assign p = all_products[p_handle]
            endif
          endif
          assign title = block.settings.title | default: p.title
          assign img = block.settings.image | default: p.featured_image
        -%}
        {%- capture href -%}{% if block.settings.link_to == 'product' and p != blank %}{{ p.url }}{% else %}{% render 'mt-link-to', key: block.settings.link_to, url: block.settings.link %}{% endif %}{%- endcapture -%}
        <article class="mt-comp" {{ block.shopify_attributes }}>
          {%- if img != blank or block.settings.art != 'none' -%}
            <a class="mt-comp-media" href="{{ href }}" tabindex="-1" aria-hidden="true">
              {%- if block.settings.badge != blank -%}<span class="mt-comp-badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
              {%- render 'mt-pack-media', image: img, art: block.settings.art, alt: '', sizes: '(min-width: 990px) 380px, 92vw', fit: 'contain' -%}
            </a>
          {%- else -%}
            <span class="mt-comp-ico">
              {%- if block.settings.badge != blank -%}<span class="mt-comp-badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
              {%- render 'mt-icon', icon: block.settings.icon -%}
            </span>
          {%- endif -%}
          <div class="mt-comp-body">
            <h3>{{ title | escape }}</h3>
            {%- if block.settings.size != blank -%}<p class="mt-comp-size">{{ block.settings.size | escape }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            <div class="mt-comp-foot">
              {%- if block.settings.button_label != blank -%}
                <a class="mt-link" href="{{ href }}">{{ block.settings.button_label | escape }}{%- render 'mt-icon', icon: 'arrow-right' -%}</a>
              {%- endif -%}
              {%- if block.settings.show_price and p != blank -%}{%- render 'mt-price', product: p -%}{%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
