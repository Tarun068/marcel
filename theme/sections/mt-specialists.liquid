    },
    {
      "type": "text",
      "id": "where_all",
      "label": "Place name for everywhere",
      "default": "India"
    },
    {
      "type": "text",
      "id": "where_search",
      "label": "Place name for a search",
      "default": "your search"
    },
    {
      "type": "text",
      "id": "near_you",
      "label": "Place name for location search",
      "default": "order of distance from you"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "text",
      "id": "role_label",
      "label": "Role",
      "default": "OSMF Specialist Doctor"
    },
    {
      "type": "text",
      "id": "registration_label",
      "label": "Registration label",
      "default": "Reg. no."
    },
    {
      "type": "text",
      "id": "call_label",
