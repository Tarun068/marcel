      "info": "[where] is the search.",
      "default": "No OSMF Specialist Doctor listed for [where] yet"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Text",
      "default": "We are adding verified specialists. Meanwhile, a MARCEL OSMF Consultant can discuss your concerns and guide your next step."
    },
    {
      "type": "text",
      "id": "empty_consult_label",
      "label": "Consultant button",
      "default": "Book a Consultation"
    },
    {
      "type": "text",
      "id": "empty_all_label",
      "label": "Show all button",
      "default": "Show all specialists"
    },
    {
      "type": "inline_richtext",
      "id": "note",
      "label": "Note",
      "default": "Only verified OSMF Specialist Doctor information is listed. Please call the clinic to confirm hours and appointments. The clinic visit is with the healthcare professional, not with MARCEL."
    },
    {"type":"header","content":"Section style"},
    {"type":"select","id":"background","label":"Background","options":[{"value":"paper","label":"White"},{"value":"mist","label":"Light"},{"value":"tint","label":"Tinted"},{"value":"navy","label":"Navy"}],"default":"paper"},
    {"type":"checkbox","id":"sheet","label":"Rounded top edge","info":"Overlaps the section above, like stacked sheets. Looks best when the background differs from the section above.","default":false},
    {"type":"select","id":"spacing","label":"Spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Compact"},{"value":"none","label":"None"}],"default":"tight"}
  ],
  "presets": [
    {
      "name": "Marcel specialist finder"
    }
  ]
