{{ 'mt-mobile-bar.css' | asset_url | stylesheet_tag }}

{%- capture wa_url -%}{% render 'mt-wa-url' %}{%- endcapture -%}

{%- if section.blocks.size > 0 -%}
  <nav class="mt mt-mbar" aria-label="Quick actions" style="--mt-mbar-cols: {{ section.blocks.size }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign style = block.settings.style
        assign link = block.settings.link
        if style == 'whatsapp' and link == blank
          assign link = wa_url
        endif
        if link == blank
          assign link = routes.root_url
        endif
        assign is_active = false
        if block.settings.link != blank and block.settings.link == request.path
          assign is_active = true
        endif
      -%}
      <a
        href="{{ link }}"
        class="mt-mbar-item mt-mbar-item--{{ style }}{% if is_active %} is-active{% endif %}"
        {% if style == 'whatsapp' %}
          target="_blank" rel="noopener"
        {% endif %}
        {% if is_active %}
          aria-current="page"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- if style == 'featured' -%}
          <span class="mt-mbar-ring">{%- render 'mt-icon', icon: block.settings.icon -%}</span>
        {%- else -%}
          {%- render 'mt-icon', icon: block.settings.icon -%}
        {%- endif -%}
        {{- block.settings.label | escape -}}
      </a>
    {%- endfor -%}
  </nav>
{%- endif -%}

