{%- style -%}
  /* Client layout 2026-11-19: copy and two route cards on the left, the booking card on the right. */
  .mt-consult-sec.mt-bg-navy { background: radial-gradient(70% 120% at 100% 0%, rgba(14, 140, 150, .32), rgba(14, 140, 150, 0) 62%), var(--mt-navy); }
  .mt-consult { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(24px, 3.4vw, 48px); align-items: center; }
  @media (max-width: 1100px) {
    .mt-consult { grid-template-columns: minmax(0, 1fr); }
  }
  .mt-consult-copy { display: grid; gap: 26px; min-width: 0; }
  .mt-consult-copy .mt-sec-head { max-width: 780px; margin-bottom: 0; }
  .mt-consult-sec .mt-sec-head .mt-eyebrow { display: inline-flex; align-items: center; gap: 14px; }
  .mt-consult-sec .mt-sec-head .mt-eyebrow::after { content: ""; width: 48px; height: 2px; border-radius: 2px; background: currentColor; opacity: .75; }
  .mt.mt-consult--serif .mt-sec-head .mt-h2 { font-family: var(--mt-serif); font-weight: 600; font-size: var(--mt-fs-h); line-height: 1.08; letter-spacing: -.02em; }

  .mt-croutes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .mt-croute { display: grid; grid-template-rows: auto 1fr auto; gap: 18px; padding: clamp(20px, 2vw, 26px); border-radius: 22px; background: rgba(255, 255, 255, .04); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .2); }
  .mt-croute-head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px; align-items: center; }
  .mt-croute-ico { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(160deg, #22B6C0, var(--mt-teal)); color: #FFFFFF; box-shadow: 0 12px 24px -14px rgba(0, 0, 0, .7); }
  .mt-croute-ico .mt-i { width: 28px; height: 28px; }
  .mt-croute-titles { display: grid; gap: 6px; min-width: 0; padding-left: 18px; border-left: 1px solid rgba(255, 255, 255, .24); }
  .mt-croute-titles b { color: var(--mt-on-dark); font-size: 20px; font-weight: 800; line-height: 1.25; }
  .mt-croute-titles small { color: var(--mt-mint); font-size: 15px; font-weight: 600; line-height: 1.35; }
  .mt-croute p { color: var(--mt-navy-ink); font-size: var(--mt-fs-body); line-height: 1.6; }
  .mt .mt-croute .mt-btn { justify-self: start; }
  .mt .mt-croute .mt-btn--outline { background: transparent; color: var(--mt-mint); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--mt-mint) 72%, transparent); }
  .mt .mt-croute .mt-btn--outline:hover { background: rgba(255, 255, 255, .06); box-shadow: inset 0 0 0 1.5px var(--mt-mint); }
  .mt-consult .mt-fine { color: rgba(255, 255, 255, .6); }
  @media (max-width: 680px) {
    .mt-croutes { grid-template-columns: minmax(0, 1fr); }
    .mt-croute-ico { width: 54px; height: 54px; }
    .mt-croute-titles { padding-left: 14px; }
  }

  /* Booking card */
  mt-slot-card { display: grid; gap: 20px; padding: clamp(22px, 2.6vw, 32px); border-radius: 28px; background: var(--mt-paper); color: var(--mt-ink-2); box-shadow: 0 30px 70px -30px rgba(0, 0, 0, .6); }
  .mt-slot-head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px; align-items: center; }
  .mt-slot-ico { display: grid; place-items: center; width: 72px; height: 72px; border-radius: 50%; background: color-mix(in srgb, var(--mt-aqua) 20%, #FFFFFF); color: var(--mt-teal); }
  .mt-slot-ico .mt-i { width: 32px; height: 32px; }
  .mt-slot-head b { display: block; color: var(--mt-ink); font-size: 22px; font-weight: 800; line-height: 1.25; }
  .mt-slot-head small { display: block; margin-top: 6px; color: var(--mt-ink-3); font-size: 15px; line-height: 1.5; }
  .mt-slot-pick { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px 18px; }
  .mt-slot-field { display: grid; gap: 10px; min-width: 0; }
  .mt-slot-field--date { flex: 1 1 190px; }
  .mt-slot-field--time { flex: 0 1 auto; }
  .mt-slot-label { color: var(--mt-ink-3); font-size: 12.5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .mt-slot-select { position: relative; display: flex; align-items: center; }
  .mt-slot-select .mt-i { position: absolute; width: 20px; height: 20px; color: var(--mt-ink-2); pointer-events: none; }
  .mt-slot-select .mt-i:first-child { left: 15px; }
  .mt-slot-select .mt-i:last-child { right: 14px; }
  .mt .mt-slot-select select { width: 100%; height: 52px; padding: 0 42px 0 46px; border: 1.5px solid var(--mt-line-2); border-radius: 14px; background: #FFFFFF; color: var(--mt-ink); font: inherit; font-size: 15.5px; font-weight: 700; cursor: pointer; -webkit-appearance: none; appearance: none; }
  .mt .mt-slot-select select:focus-visible { outline: 3px solid var(--mt-aqua); outline-offset: 2px; }
  .mt-slot-times { display: flex; flex-wrap: wrap; gap: 8px; }
  .mt .mt-slot-times a { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 16px; border-radius: 99px; background: #FFFFFF; box-shadow: inset 0 0 0 1.5px var(--mt-line-2); color: var(--mt-ink); font-size: 15.5px; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; text-decoration: none; transition: background .15s, box-shadow .15s, color .15s; }
  .mt .mt-slot-times:not(:hover, :focus-within) a:first-child,
  .mt .mt-slot-times a:hover,
  .mt .mt-slot-times a:focus-visible { background: var(--mt-teal); color: var(--mt-on-dark); box-shadow: none; }
  .mt-slot-empty { color: var(--mt-ink-3); font-size: 15px; }
  .mt-slot-mode { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px; align-items: center; padding: 16px 18px; border-radius: 16px; background: color-mix(in srgb, var(--mt-aqua) 9%, #FFFFFF); }
  .mt-slot-mode-ico { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: color-mix(in srgb, var(--mt-aqua) 22%, #FFFFFF); color: var(--mt-teal); }
  .mt-slot-mode-ico .mt-i { width: 22px; height: 22px; }
  .mt-slot-mode b { display: block; color: var(--mt-ink); font-size: 16px; font-weight: 800; line-height: 1.3; }
  .mt-slot-mode small { display: block; margin-top: 4px; color: var(--mt-ink-3); font-size: 14.5px; }
  .mt-bg-navy mt-slot-card .mt-link { width: fit-content; color: var(--mt-teal); font-size: 15.5px; font-weight: 800; }
  .mt-slot-note { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px; color: var(--mt-ink-3); font-size: 13.5px; line-height: 1.55; }
  .mt-slot-note .mt-i { width: 18px; height: 18px; margin-top: 1px; }
{%- endstyle -%}

<script src="{{ 'mt-consult.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign extra = 'mt-consult-sec'
  if section.settings.heading_font == 'serif'
    assign extra = 'mt-consult-sec mt-consult--serif'
  endif
-%}
{%- capture book_url -%}{% render 'mt-link-to', key: section.settings.card_to, url: section.settings.card_link %}{%- endcapture -%}

<section class="{% render 'mt-section-class', s: section.settings, extra: extra %}">
  <div class="mt-wrap">
    <div class="mt-consult">
      <div class="mt-consult-copy">
        {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}
        {%- if section.blocks.size > 0 -%}
          <div class="mt-croutes">
            {%- for block in section.blocks -%}
              {%- capture href -%}{% render 'mt-link-to', key: block.settings.link_to, url: block.settings.link %}{%- endcapture -%}
              {%- assign btn_label = block.settings.button_label | default: block.settings.title -%}
              <div class="mt-croute" {{ block.shopify_attributes }}>
                <div class="mt-croute-head">
                  <span class="mt-croute-ico">{%- render 'mt-icon', icon: block.settings.icon -%}</span>
                  <span class="mt-croute-titles">
                    <b>{{ block.settings.title | escape }}</b>
                    {%- if block.settings.subtitle != blank -%}<small>{{ block.settings.subtitle | escape }}</small>{%- endif -%}
                  </span>
                </div>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- else -%}<span></span>{%- endif -%}
                <a class="mt-btn{% if block.settings.button_style == 'outline' %} mt-btn--outline{% else %} mt-btn-primary{% endif %}" href="{{ href | strip }}"{% if block.settings.link_to == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>
                  {{- btn_label | escape -}}
                  {%- render 'mt-icon', icon: 'arrow-right' -%}
                </a>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_card -%}
        <mt-slot-card
          data-url="{{ book_url | strip }}"
          data-slots="{{ section.settings.slots | escape }}"
          data-closed="{{ section.settings.closed_days | escape }}"
          data-days="{{ section.settings.days_shown }}"
          data-lead="{{ section.settings.lead_minutes }}"
          data-today="{{ section.settings.today_label | escape }}"
          data-tomorrow="{{ section.settings.tomorrow_label | escape }}"
        >
          <div class="mt-slot-head">
            <span class="mt-slot-ico">{%- render 'mt-icon', icon: section.settings.card_icon -%}</span>
            <span>
              <b>{{ section.settings.card_title | escape }}</b>
              {%- if section.settings.card_text != blank -%}<small>{{ section.settings.card_text | escape }}</small>{%- endif -%}
            </span>
          </div>
          <div class="mt-slot-pick">
            <label class="mt-slot-field mt-slot-field--date">
              <span class="mt-slot-label">{{ section.settings.date_label | escape }}</span>
              <span class="mt-slot-select">
                {%- render 'mt-icon', icon: 'calendar' -%}
                <select data-mt-slot-date disabled><option>{{ section.settings.empty_text | escape }}</option></select>
                {%- render 'mt-icon', icon: 'chevron-down' -%}
              </span>
            </label>
            <div class="mt-slot-field mt-slot-field--time" role="group" aria-label="{{ section.settings.time_label | escape }}">
              <span class="mt-slot-label" aria-hidden="true">{{ section.settings.time_label | escape }}</span>
              <div class="mt-slot-times" data-mt-slot-times></div>
            </div>
          </div>
          {%- if section.settings.mode_title != blank -%}
            <div class="mt-slot-mode">
              <span class="mt-slot-mode-ico">{%- render 'mt-icon', icon: section.settings.mode_icon -%}</span>
              <span>
                <b>{{ section.settings.mode_title | escape }}</b>
                {%- if section.settings.mode_text != blank -%}<small>{{ section.settings.mode_text | escape }}</small>{%- endif -%}
              </span>
            </div>
          {%- endif -%}
          {%- if section.settings.all_label != blank -%}
            <a class="mt-link" href="{{ book_url | strip }}">{{ section.settings.all_label | escape }}{%- render 'mt-icon', icon: 'arrow-right' -%}</a>
          {%- endif -%}
          {%- if section.settings.note != blank -%}<p class="mt-slot-note">{%- render 'mt-icon', icon: 'info' -%}<span>{{ section.settings.note }}</span></p>{%- endif -%}
        </mt-slot-card>
      {%- elsif section.settings.note != blank -%}
        <p class="mt-fine">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

