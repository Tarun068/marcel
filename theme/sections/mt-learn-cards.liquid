            { "value": "do", "label": "Do (green ticks)" }
          ],
          "default": "do"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Replaces the built-in photo."
        },
        {
          "type": "select",
          "id": "art",
          "label": "Built-in photo",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "unclear-dont", "label": "Spice bowls" },
            { "value": "unclear-do", "label": "Doctor with a patient" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "What Helps"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Points",
          "info": "One per line."
        }
      ]
    },
    {
      "type": "step",
      "name": "Journey step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "search", "label": "Magnifier" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "drop", "label": "Drop" },
            { "value": "box", "label": "Box" },
            { "value": "chart", "label": "Chart" },
            { "value": "target", "label": "Target" },
            { "value": "routine", "label": "Routine list" },
            { "value": "doctor", "label": "Doctor" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Tick" }
          ],
          "default": "search"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Colour",
          "options": [
            { "value": "teal", "label": "Teal" },
            { "value": "rose", "label": "Rose" },
            { "value": "amber", "label": "Amber" },
            { "value": "sky", "label": "Blue" },
            { "value": "violet", "label": "Violet" },
