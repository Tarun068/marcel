      ]
    },
    {
      "type": "label",
      "name": "Diagram label",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Label"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Second line"
        },
        {
          "type": "range",
          "id": "x",
