{{ 'mt-pages.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .mt-support-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .mt-support-grid--1 { grid-template-columns: minmax(0, 1fr); max-width: 760px; }
  @media (max-width: 860px) {
    .mt-support-grid { grid-template-columns: minmax(0, 1fr); }
  }
  .mt-route { display: grid; gap: 16px; align-content: start; padding: clamp(22px, 3vw, 30px); border-radius: var(--mt-r-xl); background: var(--mt-paper); border: 1px solid var(--mt-line); }
  .mt-bg-paper .mt-route { background: var(--mt-mist); border-color: transparent; }
  .mt-bg-navy .mt-route { background: rgba(255, 255, 255, .06); border-color: rgba(255, 255, 255, .14); }
  .mt-route-top { display: flex; gap: 14px; align-items: center; }
  .mt-route-top .mt-wico { width: 52px; height: 52px; border-radius: 16px; background: var(--mt-tint); color: var(--mt-teal); }
  .mt-bg-navy .mt-route-top .mt-wico { background: rgba(var(--mt-aqua-rgb), .18); color: var(--mt-mint); }
  .mt-route-top .mt-wico .mt-i { width: 26px; height: 26px; }
  .mt .mt-route h3 { font-size: var(--mt-fs-sub); line-height: 1.2; letter-spacing: -.015em; }
  .mt-route-sub { font-size: 14px; font-weight: 700; color: var(--mt-ink-3); }
  .mt-bg-navy .mt-route-sub { color: var(--mt-navy-ink); }
  .mt-route .mt-checks li { font-size: var(--mt-fs-body); }
  .mt-route .mt-btn-row { margin-top: auto; padding-top: 4px; }
  .mt-support-note { margin-top: 18px; }
{%- endstyle -%}

{%- assign routes_list = section.blocks | where: 'type', 'route' -%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-support' %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="mt-wrap">
    {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, center: section.settings.center -%}
    <div class="mt-support-grid{% if routes_list.size == 1 %} mt-support-grid--1{% endif %}">
      {%- for block in routes_list -%}
        {%- liquid
          assign points = block.settings.points | newline_to_br | split: '<br />'
        -%}
        {%- capture href1 -%}{% render 'mt-link-to', key: block.settings.link_to, url: block.settings.link %}{%- endcapture -%}
        {%- capture href2 -%}{% render 'mt-link-to', key: block.settings.link2_to, url: block.settings.link2 %}{%- endcapture -%}
        <article class="mt-route" {{ block.shopify_attributes }}>
          <div class="mt-route-top">
            <span class="mt-wico">{%- render 'mt-icon', icon: block.settings.icon -%}</span>
            <div>
              {%- if block.settings.eyebrow != blank -%}<span class="mt-eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
              <h3>{{ block.settings.title | escape }}</h3>
            </div>
          </div>
          {%- if block.settings.subtitle != blank -%}<p class="mt-route-sub">{{ block.settings.subtitle | escape }}</p>{%- endif -%}
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          {%- if block.settings.points != blank -%}
            <ul class="mt-checks">
              {%- for line in points -%}
                {%- assign item = line | strip -%}
                {%- if item != blank -%}<li>{%- render 'mt-icon', icon: 'check' -%}<span>{{ item | escape }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="mt-btn-row">
            {%- if block.settings.button_label != blank -%}
              <a class="mt-btn {% if section.settings.background == 'navy' %}mt-btn-light{% else %}mt-btn-primary{% endif %}" href="{{ href1 }}"{% if block.settings.link_to == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>
                {%- if block.settings.link_to == 'whatsapp' -%}{%- render 'mt-icon', icon: 'whatsapp' -%}{%- endif -%}
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
            {%- if block.settings.button2_label != blank -%}
              <a class="mt-btn {% if section.settings.background == 'navy' %}mt-btn-outline-light{% else %}mt-btn-secondary{% endif %}" href="{{ href2 }}"{% if block.settings.link2_to == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>
                {%- if block.settings.link2_to == 'whatsapp' -%}{%- render 'mt-icon', icon: 'whatsapp' -%}{%- endif -%}
                {{- block.settings.button2_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}
      <div class="mt-callout mt-callout--muted mt-support-note">{%- render 'mt-icon', icon: 'info' -%}<span>{{ section.settings.note }}</span></div>
    {%- endif -%}
  </div>
</section>

