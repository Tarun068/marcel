{%- style -%}
  .mt-steps { position: relative; display: grid; grid-template-columns: repeat(var(--mt-cols, 4), minmax(0, 1fr)); gap: 28px; counter-reset: mt-step; }
  .mt-steps::before { content: ""; position: absolute; top: 20px; left: 20px; right: calc(100% / var(--mt-cols, 4) - 20px); height: 2px; background: var(--mt-line-2); }
  .mt-step { position: relative; display: grid; gap: 10px; align-content: start; }
  .mt-step .mt-num { position: relative; margin-bottom: 8px; box-shadow: 0 0 0 6px var(--mt-section-bg, var(--mt-paper)); }
  .mt .mt-step h3 { font-size: var(--mt-fs-sub); line-height: 1.25; letter-spacing: -.01em; }
  .mt-step p { font-size: var(--mt-fs-body); line-height: 1.55; }
  @media (max-width: 900px) {
    .mt-steps { grid-template-columns: minmax(0, 1fr); gap: 0; max-width: 560px; }
    .mt-steps::before { display: none; }
    .mt-step:not(:last-child)::after { content: ""; position: absolute; left: 19px; top: 46px; bottom: 6px; width: 2px; background: var(--mt-line-2); }
    .mt-step { grid-template-columns: 40px minmax(0, 1fr); column-gap: 18px; row-gap: 4px; padding-bottom: 26px; }
    .mt-step .mt-num { grid-row: span 2; margin-bottom: 0; }
    .mt .mt-step h3 { margin-top: 8px; }
  }
  .mt-steps.mt-steps--journey { grid-template-columns: minmax(0, 1fr); gap: 0; max-width: 760px; }
  .mt-steps--journey::before { display: none; }
  .mt-steps--journey .mt-step { grid-template-columns: 48px minmax(0, 1fr); column-gap: 20px; row-gap: 6px; padding-bottom: 30px; }
  .mt-steps--journey .mt-step:not(:last-child)::after { content: ""; position: absolute; left: 23px; top: 56px; bottom: 6px; width: 2px; background: var(--mt-line-2); }
  .mt-steps--journey .mt-num { grid-row: span 2; width: 48px; height: 48px; margin-bottom: 0; font-size: 18px; }
  .mt .mt-steps--journey .mt-step h3 { margin-top: 10px; font-size: var(--mt-fs-sub); }
  .mt-steps--journey .mt-step p { max-width: 60ch; font-size: var(--mt-fs-body); }
  .mt-steps-sec .mt-steps + .mt-btn-row { margin-top: 12px; }
{%- endstyle -%}

{%- liquid
  assign link = section.settings.link | default: routes.root_url
-%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-steps-sec' %}">
  <div class="mt-wrap">
    <div class="mt-sec-head-row">
      {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}
      {%- if section.settings.link_label != blank -%}
        <a class="mt-link" href="{{ link }}">
          {{- section.settings.link_label | escape -}}
          {%- render 'mt-icon', icon: 'arrow-right' -%}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="mt-steps{% if section.settings.layout == 'journey' %} mt-steps--journey{% endif %}" style="--mt-cols: {{ section.blocks.size | at_most: 4 }};">
        {%- for block in section.blocks -%}
          <li class="mt-step" {{ block.shopify_attributes }}>
            <span class="mt-num">{{ block.settings.number | default: forloop.index | escape }}</span>
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="mt-btn-row">
        <a class="mt-btn mt-btn-primary" href="{{ section.settings.button_link | default: settings.mt_link_test | default: routes.root_url }}">
          {{- section.settings.button_label | escape -}}
          {%- render 'mt-icon', icon: 'arrow-right' -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
