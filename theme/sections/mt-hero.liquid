{{ 'mt-hero.css' | asset_url | stylesheet_tag }}

{%- capture btn1_link -%}{% render 'mt-link-to', key: section.settings.button_1_to, url: section.settings.button_1_link %}{%- endcapture -%}
{%- capture btn2_link -%}{% render 'mt-link-to', key: section.settings.button_2_to, url: section.settings.button_2_link %}{%- endcapture -%}
{%- liquid
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign pillar_blocks = section.blocks | where: 'type', 'pillar'
-%}

<section class="mt mt-hero mt-bg-{{ section.settings.background }}{% if section.settings.pattern %} mt-hero--pattern{% endif %}{% if section.settings.heading_font == 'serif' %} mt-hero--serif{% endif %}">
  <div class="mt-wrap mt-hero-grid">
    <div class="mt-hero-copy">
      {%- if section.settings.pill_text != blank -%}
        <span class="mt-hero-pill">
          {%- if section.settings.pill_icon != 'none' -%}<span class="mt-hero-pill-dot">{%- render 'mt-icon', icon: section.settings.pill_icon -%}</span>{%- endif -%}
          {{- section.settings.pill_text | escape -}}
        </span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="mt-display">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="mt-lead">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="mt-hero-tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="mt-btn-row mt-hero-ctas">
          {%- if section.settings.button_1_label != blank -%}
            <a class="mt-btn mt-btn-primary" href="{{ btn1_link }}">
              {{- section.settings.button_1_label | escape -}}
              {%- render 'mt-icon', icon: 'arrow-right' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a class="mt-btn mt-btn-secondary" href="{{ btn2_link }}">
              {%- render 'mt-icon', icon: section.settings.button_2_icon -%}
              {{- section.settings.button_2_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if trust_blocks.size > 0 -%}
        <ul class="mt-trust-row">
          {%- for block in trust_blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- render 'mt-icon', icon: block.settings.icon -%}
              {{- block.settings.text | escape -}}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="mt-hero-photo">
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt, sizes: '(min-width: 990px) 46vw, 100vw', widths: '480, 720, 960, 1200, 1400'
        }}
        {%- if section.settings.photo_note != blank -%}
          <span class="mt-hero-photo-note">{{ section.settings.photo_note | escape }}</span>
        {%- endif -%}
      </div>
    {%- elsif section.settings.default_image -%}
      <div class="mt-hero-photo">
        <img src="{{ 'mt-hero-doctor.webp' | asset_url }}" alt="" width="1000" height="1000" fetchpriority="high">
        {%- if section.settings.photo_note != blank -%}
          <span class="mt-hero-photo-note">{{ section.settings.photo_note | escape }}</span>
        {%- endif -%}
      </div>
    {%- elsif pillar_blocks.size > 0 -%}
      <div class="mt-hero-card">
        {%- if section.settings.card_title != blank -%}<p class="mt-mini-h">{{ section.settings.card_title | escape }}</p>{%- endif -%}
        <ol class="mt-hero-pillars">
          {%- for block in pillar_blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="mt-wico">{%- render 'mt-icon', icon: block.settings.icon -%}</span>
              <span>
                <b>{{ block.settings.title | escape }}</b>
                {%- if block.settings.text != blank -%}<small>{{ block.settings.text | escape }}</small>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ol>
        {%- if section.settings.card_note != blank -%}<p class="mt-fine">{{ section.settings.card_note | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

