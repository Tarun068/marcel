{{ 'mt-pages.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .mt-phases { position: relative; display: grid; grid-template-columns: repeat(var(--mt-cols, 4), minmax(0, 1fr)); gap: 14px; counter-reset: mt-phase; }
  @media (max-width: 1000px) {
    .mt-phases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .mt-phases { grid-template-columns: minmax(0, 1fr); }
  }
  .mt-phase { display: grid; gap: 10px; align-content: start; padding: 22px; border-radius: var(--mt-r-lg); background: var(--mt-paper); border: 1px solid var(--mt-line); border-top: 4px solid var(--tone, var(--mt-teal)); }
  .mt-bg-paper .mt-phase { background: var(--mt-mist); border-color: transparent; border-top-color: var(--tone, var(--mt-teal)); }
  .mt-phase-when { display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--tone, var(--mt-teal)); }
  .mt-phase-when .mt-i { width: 18px; height: 18px; }
  .mt .mt-phase h3 { font-size: 21px; line-height: 1.2; letter-spacing: -.015em; }
  .mt-phase p { font-size: 15px; line-height: 1.55; }
  .mt-phase .mt-checks li { font-size: 14.5px; }
  .mt-phase-foot { margin-top: 4px; padding-top: 12px; border-top: 1px solid var(--mt-line); font-size: 14.5px; font-weight: 700; color: var(--mt-ink); }

  /* Timeline layout: a vertical list with a line, used for the development journey. */
  .mt-phases--timeline { grid-template-columns: minmax(0, 1fr); gap: 0; max-width: 860px; }
  .mt-phases--timeline .mt-phase { position: relative; grid-template-columns: 150px minmax(0, 1fr); column-gap: 28px; padding: 0 0 30px; border: 0; border-radius: 0; background: none; }
  .mt-phases--timeline .mt-phase::before { content: ""; position: absolute; left: 150px; top: 6px; width: 12px; height: 12px; margin-left: 8px; border-radius: 99px; background: var(--tone, var(--mt-teal)); box-shadow: 0 0 0 5px var(--mt-section-bg, var(--mt-paper)); }
  .mt-phases--timeline .mt-phase:not(:last-child)::after { content: ""; position: absolute; left: 163px; top: 22px; bottom: 0; width: 2px; background: var(--mt-line-2); }
  .mt-phases--timeline .mt-phase-when { grid-row: span 4; align-self: start; padding-top: 2px; font-size: 15px; letter-spacing: .02em; text-transform: none; }
  .mt-phases--timeline .mt-phase > :not(.mt-phase-when) { grid-column: 2; padding-left: 20px; }
  .mt-phases--timeline .mt-phase-foot { border: 0; padding-top: 0; }
  @media (max-width: 600px) {
    .mt-phases--timeline .mt-phase { grid-template-columns: minmax(0, 1fr); padding-left: 30px; }
    .mt-phases--timeline .mt-phase::before { left: 0; margin-left: 0; }
    .mt-phases--timeline .mt-phase:not(:last-child)::after { left: 5px; }
    .mt-phases--timeline .mt-phase-when { grid-row: auto; }
    .mt-phases--timeline .mt-phase > :not(.mt-phase-when) { grid-column: 1; padding-left: 0; }
  }
  .mt-journey-foot { display: grid; gap: 16px; margin-top: 22px; }
  .mt-journey-foot--center { justify-items: center; text-align: center; }
  .mt-journey-foot--center .mt-callout { max-width: 860px; }
  .mt-journey-foot--center .mt-btn-row { justify-content: center; }

  /* Flow layout: large icons joined by arrows, then a vertical list on smaller screens. */
  .mt-phases--flow { gap: 18px; }
  .mt-phases--flow .mt-phase { position: relative; justify-items: center; gap: 8px; padding: 0; border: 0; border-radius: 0; background: none; text-align: center; }
  .mt-bg-paper .mt-phases--flow .mt-phase { background: none; }
  .mt-phase-ico { position: relative; z-index: 1; display: grid; place-items: center; width: 76px; height: 76px; margin-bottom: 6px; border-radius: 99px; background: var(--mt-paper); box-shadow: inset 0 0 0 2px var(--tone, var(--mt-teal)); color: var(--tone, var(--mt-teal)); }
  .mt-bg-paper .mt-phase-ico { background: var(--mt-mist); }
  .mt-phase-ico .mt-i { width: 36px; height: 36px; stroke-width: 1.5; }
  .mt-phases--flow .mt-phase-when { justify-content: center; }
  .mt .mt-phases--flow .mt-phase h3 { font-size: 18px; }
  .mt-phases--flow .mt-phase p { font-size: 14.5px; }
  @media (min-width: 1001px) {
    .mt-phases--flow .mt-phase:not(:last-child)::after { content: ""; position: absolute; top: 37px; left: calc(50% + 46px); width: calc(100% + 18px - 92px); border-top: 2px dashed var(--mt-line-2); }
    .mt-phases--flow .mt-phase:not(:last-child)::before { content: ""; position: absolute; top: 33px; left: calc(150% + 18px - 54px); width: 8px; height: 8px; border-top: 2px solid var(--mt-line-2); border-right: 2px solid var(--mt-line-2); transform: rotate(45deg); }
  }
  @media (max-width: 1000px) {
    .mt-phases--flow { grid-template-columns: minmax(0, 1fr); gap: 0; max-width: 620px; }
    .mt-phases--flow .mt-phase { grid-template-columns: 60px minmax(0, 1fr); column-gap: 18px; row-gap: 4px; justify-items: start; padding-bottom: 24px; text-align: left; }
    .mt-phases--flow .mt-phase > :not(.mt-phase-ico) { grid-column: 2; }
    .mt-phase-ico { grid-row: span 3; width: 60px; height: 60px; margin: 0; }
    .mt-phase-ico .mt-i { width: 28px; height: 28px; }
    .mt-phases--flow .mt-phase:not(:last-child)::after { content: ""; position: absolute; left: 29px; top: 64px; bottom: 4px; border-left: 2px dashed var(--mt-line-2); }
  }
{%- endstyle -%}

{%- assign phases = section.blocks | where: 'type', 'phase' -%}
{%- capture href -%}{% render 'mt-link-to', key: section.settings.button_to, url: section.settings.button_link %}{%- endcapture -%}
{%- capture href2 -%}{% render 'mt-link-to', key: section.settings.button2_to, url: section.settings.button2_link %}{%- endcapture -%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-journey' %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="mt-wrap">
    {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, center: section.settings.center -%}
    <ol class="mt-phases{% if section.settings.layout != 'cards' %} mt-phases--{{ section.settings.layout }}{% endif %}" style="--mt-cols: {{ phases.size | at_most: section.settings.columns }};">
      {%- for block in phases -%}
        {%- assign points = block.settings.points | newline_to_br | split: '<br />' -%}
        <li class="mt-phase"{% if block.settings.tone != blank %} style="--tone: {{ block.settings.tone }};"{% endif %} {{ block.shopify_attributes }}>
          {%- if section.settings.layout == 'flow' -%}
            <span class="mt-phase-ico">{%- render 'mt-icon', icon: block.settings.icon -%}</span>
            {%- if block.settings.when != blank -%}<span class="mt-phase-when">{{ block.settings.when | escape }}</span>{%- endif -%}
          {%- else -%}
            <span class="mt-phase-when">{%- render 'mt-icon', icon: block.settings.icon -%}{{ block.settings.when | escape }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          {%- if block.settings.points != blank -%}
            <ul class="mt-checks">
              {%- for line in points -%}
                {%- assign item = line | strip -%}
                {%- if item != blank -%}<li>{%- render 'mt-icon', icon: 'check' -%}<span>{{ item | escape }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if block.settings.foot != blank -%}<p class="mt-phase-foot">{{ block.settings.foot | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.note != blank or section.settings.button_label != blank -%}
      <div class="mt-journey-foot{% if section.settings.center %} mt-journey-foot--center{% endif %}">
        {%- if section.settings.note != blank -%}
          <div class="mt-callout mt-callout--muted">{%- render 'mt-icon', icon: 'info' -%}<span>{{ section.settings.note }}</span></div>
        {%- endif -%}
        {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
          <div class="mt-btn-row">
            {%- if section.settings.button_label != blank -%}<a class="mt-btn mt-btn-primary" href="{{ href }}">{{ section.settings.button_label | escape }}{%- render 'mt-icon', icon: 'arrow-right' -%}</a>{%- endif -%}
            {%- if section.settings.button2_label != blank -%}<a class="mt-btn mt-btn-secondary" href="{{ href2 }}">{{ section.settings.button2_label | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

