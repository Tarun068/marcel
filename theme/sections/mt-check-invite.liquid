{%- style -%}
  .mt-invite { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  @media (max-width: 900px) {
    .mt-invite { grid-template-columns: minmax(0, 1fr); }
  }
  .mt-invite-copy { display: grid; gap: 20px; }
  .mt-invite-copy .mt-sec-head { margin-bottom: 0; }
  .mt-invite-copy .mt-checks li { font-size: 16px; color: var(--mt-ink); }
  .mt-invite-preview { display: grid; gap: 14px; padding: clamp(20px, 3vw, 30px); border-radius: var(--mt-r-xl); background: var(--mt-paper); box-shadow: 0 24px 50px -28px rgba(13, 38, 59, .35), inset 0 0 0 1px var(--mt-line); }
  .mt-bg-paper .mt-invite-preview { background: var(--mt-mist); box-shadow: none; }
  .mt-invite-step { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--mt-teal); }
  .mt-invite-step span:last-child { color: var(--mt-ink-3); letter-spacing: 0; text-transform: none; font-weight: 600; }
  .mt-invite-bar { height: 6px; border-radius: 6px; background: var(--mt-line); overflow: hidden; }
  .mt-invite-bar i { display: block; width: var(--mt-progress, 16%); height: 100%; border-radius: 6px; background: var(--mt-teal); }
  .mt .mt-invite-preview h3 { font-size: clamp(20px, 17px + .6vw, 24px); line-height: 1.2; letter-spacing: -.015em; }
  .mt-invite-opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .mt .mt-invite-opts .mt-opt { min-height: 74px; padding: 14px 16px; }
  .mt-invite-opts .mt-opt b { font-size: 17px; }
  .mt-invite-opts .mt-opt small { font-size: 14px; }
  /* Answers are real radio buttons; the label carries the look of the self-check options. */
  .mt .mt-invite-opts .mt-opt { position: relative; cursor: pointer; }
  .mt-invite-opts input { position: absolute; opacity: 0; pointer-events: none; }
  .mt .mt-invite-opts .mt-opt:has(input:checked) { background: var(--mt-tint); box-shadow: inset 0 0 0 2px var(--mt-teal); }
  .mt-invite-opts .mt-opt:has(input:checked) .mt-opt-radio { background: var(--mt-teal); box-shadow: none; }
  .mt-invite-opts .mt-opt:has(input:checked) .mt-opt-radio .mt-i { opacity: 1; }
  .mt-invite-opts .mt-opt:has(input:focus-visible) { outline: 2px solid var(--mt-teal); outline-offset: 2px; }
  .mt-invite-foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding-top: 14px; border-top: 1px dashed var(--mt-line-2); }
  .mt-invite-foot p { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--mt-ink-3); }
  .mt-invite-foot p .mt-i { width: 17px; height: 17px; color: var(--mt-teal); flex: none; }
  .mt .mt-invite-foot .mt-btn { min-height: 48px; padding-inline: 22px; }
  /* Until an answer is chosen the button looks inactive; choosing one wakes it up. */
  .mt .mt-invite-preview:not(:has(input:checked)) .mt-invite-foot .mt-btn { opacity: .45; box-shadow: none; }
  @media (max-width: 480px) {
    .mt-invite-opts { gap: 8px; }
    .mt .mt-invite-opts .mt-opt { gap: 10px; padding: 12px 10px; }
    .mt-invite-opts .mt-opt b { font-size: 15.5px; }
    .mt-invite-opts .mt-opt small { font-size: 13px; }
    .mt-invite-foot { flex-direction: column; align-items: stretch; }
    .mt .mt-invite-foot .mt-btn { width: 100%; }
  }
{%- endstyle -%}

{%- capture btn1_link -%}{% render 'mt-link-to', key: section.settings.button_1_to, url: section.settings.button_1_link %}{%- endcapture -%}
{%- capture btn2_link -%}{% render 'mt-link-to', key: section.settings.button_2_to, url: section.settings.button_2_link %}{%- endcapture -%}
{%- capture test_url -%}{% render 'mt-link-to', key: section.settings.test_to, url: section.settings.test_link %}{%- endcapture -%}
{%- liquid
  assign points = section.settings.points | newline_to_br | split: '<br />'
  assign options = section.settings.preview_options | newline_to_br | split: '<br />'
-%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-check-invite' %}">
  <div class="mt-wrap">
    <div class="mt-invite">
      <div class="mt-invite-copy">
        {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}
        {%- if section.settings.points != blank -%}
          <ul class="mt-checks">
            {%- for line in points -%}
              {%- assign item = line | strip -%}
              {%- if item != blank -%}<li>{%- render 'mt-icon', icon: 'check' -%}<span>{{ item | escape }}</span></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="mt-btn-row">
            {%- if section.settings.button_1_label != blank -%}
              <a class="mt-btn mt-btn-primary" href="{{ btn1_link }}"{% if section.settings.button_1_to == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>
                {{- section.settings.button_1_label | escape -}}
                {%- render 'mt-icon', icon: 'arrow-right' -%}
              </a>
            {%- endif -%}
            {%- if section.settings.button_2_label != blank -%}
              <a class="mt-btn mt-btn-secondary" href="{{ btn2_link }}"{% if section.settings.button_2_to == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.button_2_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.note != blank -%}<p class="mt-fine">{{ section.settings.note }}</p>{%- endif -%}
      </div>

      {%- if section.settings.preview_question != blank -%}
        {%- comment -%} A plain GET form, so the chosen answer reaches the self-check as ?opening=… even without JavaScript. {%- endcomment -%}
        <form action="{{ test_url | strip }}" method="get">
          <div class="mt-invite-preview">
            <div class="mt-invite-step">
              <span>{{ section.settings.preview_step | escape }}</span>
              <span>{{ section.settings.preview_topic | escape }}</span>
            </div>
            <div class="mt-invite-bar"><i></i></div>
            <h3 id="MtInviteQ-{{ section.id }}">{{ section.settings.preview_question | escape }}</h3>
            <div class="mt-invite-opts" role="radiogroup" aria-labelledby="MtInviteQ-{{ section.id }}">
              {%- for line in options -%}
                {%- assign parts = line | split: '|' -%}
                {%- assign value = parts[0] | strip -%}
                {%- assign label = parts[1] | strip -%}
                {%- if value != blank and label != blank -%}
                  <label class="mt-opt">
                    <input type="radio" name="opening" value="{{ value | escape }}" required>
                    <span class="mt-opt-radio">{%- render 'mt-icon', icon: 'check' -%}</span>
                    <span>
                      <b>{{ label | escape }}</b>
                      {%- if parts[2] != blank -%}<small>{{ parts[2] | strip | escape }}</small>{%- endif -%}
                    </span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="mt-invite-foot">
              {%- if section.settings.preview_result != blank -%}
                <p>{%- render 'mt-icon', icon: 'lock' -%}{{ section.settings.preview_result | escape }}</p>
              {%- endif -%}
              <button type="submit" class="mt-btn mt-btn-primary">
                {{- section.settings.continue_label | escape -}}
                {%- render 'mt-icon', icon: 'arrow-right' -%}
              </button>
            </div>
          </div>
        </form>
      {%- endif -%}
    </div>
  </div>
</section>

