{{ 'mt-learn.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Stage rows (Understand OSMF, client references 2026-11-21): numbered stages on a coloured line, each with a
  stage name, title, text, tags, a mouth opening photo and the finger and millimetre measure; then an optional
  alert line, a wide button and small print. Stage names and ranges follow the client's Mouth Opening Guide.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="{% render 'mt-section-class', s: s, extra: 'mt-lx mt-lst' %}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="mt-wrap">
    {%- render 'mt-learn-head', eyebrow: s.eyebrow, heading: s.heading, text: s.text, mark: s.heading_mark -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="mt-lst-list" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- assign next = section.blocks[forloop.index] -%}
          {%- capture tags -%}
            {%- assign lines = b.tags | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}{%- assign t = line | strip -%}{%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}{%- endfor -%}
          {%- endcapture -%}
          <li class="mt-lst-row" style="--c: {{ b.color }};{% if next %} --c-next: {{ next.settings.color }};{% endif %}" {{ block.shopify_attributes }}>
            <span class="mt-lst-num" aria-hidden="true">{{ b.number | escape }}</span>
            <div class="mt-lst-card">
              <div class="mt-lst-copy">
                {%- if b.name != blank -%}<span class="mt-lst-pill">{{ b.name | escape }}</span>{%- endif -%}
                {%- if b.title != blank -%}<h3 class="mt-h3 mt-lst-title">{{ b.title | escape }}</h3>{%- endif -%}
                {%- if b.text != blank -%}<p class="mt-lst-text">{{ b.text | escape }}</p>{%- endif -%}
                {%- if tags != blank -%}<ul class="mt-lst-tags" role="list">{{ tags }}</ul>{%- endif -%}
              </div>
              {%- if b.image != blank or b.art != 'none' -%}
                <div class="mt-lst-pic">{%- render 'mt-learn-pic', image: b.image, art: b.art, alt: b.alt, sizes: '(min-width: 990px) 240px, 45vw' -%}</div>
              {%- endif -%}
              {%- if b.fingers != blank or b.range != blank -%}
                <div class="mt-lst-measure">
                  {%- if b.fingers != blank -%}
                    <span class="mt-lst-fingers">
                      {%- if s.measure_label != blank -%}<small>{{ s.measure_label | escape }}</small>{%- endif -%}
                      {{- b.fingers | escape -}}
                    </span>
                  {%- endif -%}
                  {%- if b.range != blank -%}<span class="mt-lst-range">{{ b.range | escape }}</span>{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if s.alert != blank -%}
      <div class="mt-lst-alert">{%- render 'mt-icon', icon: 'alert' -%}<p>{{ s.alert }}</p></div>
    {%- endif -%}

    {%- if s.cta_label != blank -%}
      {%- capture href -%}{% render 'mt-link-to', key: s.cta_to, url: s.cta_link %}{%- endcapture -%}
      <a class="mt-lst-cta" href="{{ href | strip }}"{% if s.cta_to == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>
        <span>{{ s.cta_label }}</span>
        <span class="mt-lst-cta-arrow">{%- render 'mt-icon', icon: 'arrow-right' -%}</span>
      </a>
    {%- endif -%}

    {%- if s.note != blank -%}<p class="mt-fine mt-lst-note">{{ s.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Marcel stage rows",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Link name",
      "info": "Links can jump here with #link-name, for example #stages.",
      "default": "stages"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "How OSMF Progresses Over Time"
    },
    {
      "type": "checkbox",
      "id": "heading_mark",
      "label": "Brush line under the heading",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "text",
      "id": "measure_label",
      "label": "Label above the finger count",
      "default": "Mouth opening"
    },
    {
      "type": "inline_richtext",
      "id": "alert",
      "label": "Alert under the stages",
      "info": "Leave empty to hide it."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "inline_richtext",
      "id": "cta_label",
      "label": "Button text",
      "info": "Bold words show in yellow. Leave empty to hide the button."
    },
    {
      "type": "select",
      "id": "cta_to",
      "label": "Button opens",
      "options": [
        { "value": "custom", "label": "Custom link below" },
        { "value": "test", "label": "MARCEL OSMF Self-Check" },
        { "value": "therapy", "label": "MARCEL OMR Therapy page" },
        { "value": "foundation", "label": "Foundation Kit page" },
        { "value": "advance", "label": "Advance Kit page" },
        { "value": "journey", "label": "12-Week Care Journey" },
        { "value": "consult", "label": "MARCEL OSMF Consultant booking" },
        { "value": "specialists", "label": "Find an OSMF Specialist" },
        { "value": "help", "label": "Get Help page" },
        { "value": "whatsapp", "label": "WhatsApp chat" }
      ],
      "default": "test"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Custom link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "mist", "label": "Light" },
        { "value": "tint", "label": "Tinted" }
      ],
      "default": "paper"
    },
    {
      "type": "checkbox",
      "id": "sheet",
      "label": "Rounded top edge",
      "default": false
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "tight", "label": "Compact" },
        { "value": "none", "label": "None" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Stage name",
          "default": "Stage 1: Early"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Colour",
          "default": "#2B9759"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "textarea",
          "id": "tags",
          "label": "Tags",
          "info": "One per line."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Replaces the built-in photo."
        },
        {
          "type": "select",
          "id": "art",
          "label": "Built-in photo",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "stage-1", "label": "Mouth opening, stage 1" },
            { "value": "stage-2", "label": "Mouth opening, stage 2" },
            { "value": "stage-3", "label": "Mouth opening, stage 3" },
            { "value": "stage-4", "label": "Mouth opening, stage 4" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Photo description"
        },
        {
          "type": "text",
          "id": "fingers",
          "label": "Finger count",
          "default": "4 Fingers"
        },
        {
          "type": "text",
          "id": "range",
          "label": "Range",
          "default": "More than 35 mm"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marcel stage rows"
    }
  ]
}
{% endschema %}
