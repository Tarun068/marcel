{{ 'mt-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign link = section.settings.link | default: routes.all_products_collection_url
  assign card_blocks = section.blocks | where: 'type', 'product'
  assign kit = section.settings.kit_product
  assign kit_link = section.settings.kit_link | default: kit.url | default: routes.all_products_collection_url
  assign carousel = false
  if section.settings.layout == 'carousel' and card_blocks.size > 1
    assign carousel = true
  endif
  assign per = section.settings.per_desktop | default: '4'
  assign compact_cards = true
  if section.settings.card_style == 'detailed'
    assign compact_cards = false
  endif
  assign card_sizes = '(min-width: 1440px) 450px, (min-width: 961px) 31vw, (min-width: 761px) 46vw, 82vw'
  if carousel
    assign card_sizes = '(min-width: 1440px) 340px, (min-width: 750px) 36vw, 82vw'
    if per == '3'
      assign card_sizes = '(min-width: 1440px) 450px, (min-width: 750px) 36vw, 82vw'
    endif
  endif
-%}
{%- if carousel -%}
  {{ 'mt-carousel.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'mt-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-products' %}">
  {%- if carousel -%}
    <mt-carousel
      class="mt-wrap mt-car mt-car--{{ per }}"
      style="--per-d: {{ per }};"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.heading | strip_html | escape }}"
    >
  {%- else -%}
    <div class="mt-wrap">
  {%- endif -%}
    <div class="mt-sec-head-row">
      {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}
      {%- if section.settings.link_label != blank or carousel -%}
        <div class="mt-car-side">
          {%- if section.settings.link_label != blank -%}
            <a class="mt-link" href="{{ link }}">
              {{- section.settings.link_label | escape -}}
              {%- render 'mt-icon', icon: 'arrow-right' -%}
            </a>
          {%- endif -%}
          {%- if carousel -%}
            <div class="mt-car-nav" hidden>
              <button type="button" class="mt-car-arrow" data-dir="-1" aria-label="{{ section.settings.prev_label | escape }}">
                {%- render 'mt-icon', icon: 'arrow-left' -%}
              </button>
              <button type="button" class="mt-car-arrow" data-dir="1" aria-label="{{ section.settings.next_label | escape }}">
                {%- render 'mt-icon', icon: 'arrow-right' -%}
              </button>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if card_blocks.size > 0 -%}
      {%- if carousel -%}
        <ul class="mt-car-track" role="list">
      {%- else -%}
        <div class="mt-pgrid mt-swipe">
      {%- endif -%}
        {%- for block in card_blocks -%}
          {%- liquid
            assign card_product = block.settings.product
            if card_product == blank
              capture card_handle
                render 'mt-product-handle', art: block.settings.art
              endcapture
              if card_handle != blank
                assign card_product = all_products[card_handle]
              endif
            endif

            # One size of a product, for example Smile 30 g and Smile 100 g as two cards.
            assign card_variant = ''
            if card_product != blank and block.settings.variant != blank
              assign want = block.settings.variant | downcase | remove: ' '
              for v in card_product.variants
                assign v_title = v.title | downcase | remove: ' '
                if v_title == want
                  assign card_variant = v
                  break
                endif
              endfor
            endif

            # Cards without a product (for example a kit not yet sold online) link to a page instead.
            assign card_link = link
            assign card_add = section.settings.add_label
            if card_product == blank and block.settings.link_to != blank and block.settings.link_to != 'none'
              capture card_link
                render 'mt-link-to', key: block.settings.link_to, url: block.settings.link
              endcapture
              assign card_link = card_link | strip
              assign card_add = block.settings.link_label | default: section.settings.add_label
            endif
          -%}
          {%- if carousel -%}<li class="mt-car-item">{%- endif -%}
          {%- render 'mt-product-card',
            product: card_product,
            variant: card_variant,
            block: block,
            compact: compact_cards,
            section_id: section.id,
            add_label: card_add,
            details_label: section.settings.details_label,
            sold_out_label: section.settings.sold_out_label,
            image_fit: section.settings.image_fit,
            sizes: card_sizes,
            fallback_url: card_link
          -%}
          {%- if carousel -%}</li>{%- endif -%}
        {%- endfor -%}
      {%- if carousel -%}
        </ul>
        <div class="mt-car-dots"></div>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.show_kit -%}
      <div class="mt-kit-banner mt-on-dark">
        <div class="mt-kit-thumbs">
          {%- if kit.featured_image != blank -%}
            <span class="mt-pack mt-kit-photo">{{ kit.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: kit.title, sizes: '200px', widths: '200, 300, 400' }}</span>
          {%- else -%}
            {%- for block in card_blocks limit: 3 -%}
              {%- liquid
                assign thumb_product = block.settings.product
                if thumb_product == blank
                  capture thumb_handle
                    render 'mt-product-handle', art: block.settings.art
                  endcapture
                  if thumb_handle != blank
                    assign thumb_product = all_products[thumb_handle]
                  endif
                endif
                assign thumb = block.settings.image | default: thumb_product.featured_image
              -%}
              {%- render 'mt-pack-media', image: thumb, art: block.settings.art, alt: '', sizes: '88px', fit: section.settings.image_fit -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="mt-stack-sm">
          {%- if section.settings.kit_eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.kit_eyebrow | escape }}</span>{%- endif -%}
          <h3>{{ section.settings.kit_heading | default: kit.title | escape }}</h3>
          {%- if section.settings.kit_text != blank -%}<p>{{ section.settings.kit_text | escape }}</p>{%- endif -%}
        </div>
        <div class="mt-btn-row">
          {%- assign kit_form_id = 'MtProductForm-' | append: section.id | append: '-kit' -%}
          {%- render 'mt-buy-button',
            product: kit,
            form_id: kit_form_id,
            section_id: section.id,
            label: section.settings.kit_add_label,
            sold_out_label: section.settings.sold_out_label,
            class: 'mt-btn mt-btn-light',
            fallback_url: kit_link
          -%}
          {%- if section.settings.kit_view_label != blank -%}
            <a class="mt-btn mt-btn-outline-light" href="{{ kit_link }}">{{ section.settings.kit_view_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- if carousel -%}
    </mt-carousel>
  {%- else -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Marcel products",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 9,
  "settings": [
