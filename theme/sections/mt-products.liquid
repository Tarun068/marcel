        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "per_desktop",
      "label": "Cards in view on large screens",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Previous button label",
      "info": "Read out by screen readers.",
      "default": "Previous products"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button label",
      "info": "Read out by screen readers.",
      "default": "Next products"
    },
    {
      "type": "header",
      "content": "Kit banner"
    },
    {
      "type": "checkbox",
      "id": "show_kit",
      "label": "Show kit banner",
      "default": false
    },
    {
      "type": "product",
