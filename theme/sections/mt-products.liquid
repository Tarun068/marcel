      "default": "Explore Our Products"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "text",
      "id": "details_label",
      "label": "Product details link",
      "info": "Leave empty to hide.",
      "default": "View product details"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "info": "Compact cards show the title, size choice, key points, price and Add to cart, and always show the whole picture.",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "detailed",
          "label": "Detailed, with best-for tag and details link"
        }
      ],
      "default": "compact"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill the square"
        },
        {
          "value": "contain",
          "label": "Show the whole image"
        }
