{{ 'mt-announcement.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div class="mt mt-announce" {{ section.shopify_attributes }}>
    <div class="mt-wrap mt-announce-row">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'span'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }}
          class="mt-announce-item{% if block.settings.hide_mobile %} mt-hide-sm{% endif %}"
          {% if block.settings.link != blank %}
            href="{{ block.settings.link }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- render 'mt-icon', icon: block.settings.icon -%}
          {{- block.settings.text | escape -}}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

