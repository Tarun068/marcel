{{ 'mt-pages.css' | asset_url | stylesheet_tag }}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-icon-cards' %}">
  <div class="mt-wrap">
    {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, center: section.settings.center -%}
    {%- if section.blocks.size > 0 -%}
      <div class="mt-cards" style="--mt-cols: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign media = section.settings.media | default: 'icon'
            assign has_photo = false
            if media != 'icon'
              if block.settings.image != blank or block.settings.art != 'none'
                assign has_photo = true
              endif
            endif
          -%}
          <div class="mt-mini-card{% if media != 'icon' %} mt-mini-card--{{ media }}{% endif %}" {{ block.shopify_attributes }}>
            {%- if has_photo -%}
              <span class="mt-card-photo">
                {%- if block.settings.image != blank -%}
                  {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 600, 900', sizes: '(min-width: 990px) 320px, (min-width: 750px) 45vw, 92vw', alt: block.settings.image.alt -}}
                {%- else -%}
                  <img src="{{ 'mt-card-' | append: block.settings.art | append: '.webp' | asset_url }}" alt="" width="360" height="360" loading="lazy">
                {%- endif -%}
              </span>
            {%- elsif media != 'icon' and block.settings.icon != 'none' -%}
              <span class="mt-card-photo mt-card-photo--icon">{%- render 'mt-icon', icon: block.settings.icon -%}</span>
            {%- else -%}
              {%- render 'mt-icon', icon: block.settings.icon -%}
            {%- endif -%}
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            {%- if block.settings.link_label != blank -%}
              {%- capture href -%}{% render 'mt-link-to', key: block.settings.link_to, url: block.settings.link %}{%- endcapture -%}
              <a class="mt-link mt-card-link" href="{{ href }}">{{ block.settings.link_label | escape }}{%- render 'mt-icon', icon: 'arrow-right' -%}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Marcel icon cards",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 12,
  "settings": [
