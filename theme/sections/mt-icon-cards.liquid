{{ 'mt-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ic_extra = 'mt-icon-cards mt-ic-accent-' | append: section.settings.accent
  assign numbered = false
  if section.settings.card_style == 'numbered'
    assign numbered = true
  endif
-%}
<section class="{% render 'mt-section-class', s: section.settings, extra: ic_extra %}">
  <div class="mt-wrap">
    {%- if section.settings.subheading != blank -%}
      {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, center: section.settings.center -%}
      <div class="mt-ic-subhead{% if section.settings.center %} mt-ic-subhead--center{% endif %}">
        <p class="mt-ic-sub">{{ section.settings.subheading | escape }}</p>
        {%- if section.settings.text != blank -%}<p class="mt-lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- else -%}
      {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, center: section.settings.center -%}
    {%- endif -%}
    {%- if section.settings.intro_title != blank or section.settings.intro_text != blank -%}
      <div class="mt-ic-intro">
        {%- if section.settings.intro_badge != blank -%}<span class="mt-ic-intro-badge" aria-hidden="true">{{ section.settings.intro_badge | escape }}</span>{%- endif -%}
        <div>
          {%- if section.settings.intro_title != blank -%}<p class="mt-ic-intro-title">{{ section.settings.intro_title | escape }}</p>{%- endif -%}
          {%- if section.settings.intro_text != blank -%}<div class="mt-ic-intro-text">{{ section.settings.intro_text }}</div>{%- endif -%}
          {%- if section.settings.intro_note != blank -%}<p class="mt-ic-intro-note">{{ section.settings.intro_note | escape }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="mt-cards" style="--mt-cols: {{ section.settings.columns }};">
        {%- liquid
          # Built-in pictures that have a whole-picture 4:3 version (mt-card-<art>-wide.webp) for "Large photo, whole picture".
          assign wide_arts = 'careplan,therapy,exercise,diet,device,consultant,doctor,tracker' | split: ','
        -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign media = section.settings.media | default: 'icon'
            assign has_photo = false
            if media != 'icon'
              if block.settings.image != blank or block.settings.art != 'none'
                assign has_photo = true
              endif
            endif
          -%}
          <div class="mt-mini-card{% if media != 'icon' %} mt-mini-card--{{ media }}{% endif %}{% if section.settings.card_style == 'benefit' or numbered %} mt-mini-card--benefit{% endif %}{% if numbered %} mt-mini-card--num{% endif %}{% if block.settings.highlight %} is-highlight{% endif %}" {{ block.shopify_attributes }}>
            {%- if has_photo -%}
              <span class="mt-card-photo">
                {%- if block.settings.image != blank -%}
                  {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 600, 900', sizes: '(min-width: 990px) 320px, (min-width: 750px) 45vw, 92vw', alt: block.settings.image.alt -}}
                {%- elsif media == 'full' and wide_arts contains block.settings.art -%}
                  <img src="{{ 'mt-card-' | append: block.settings.art | append: '-wide.webp' | asset_url }}" alt="" width="640" height="480" loading="lazy">
                {%- else -%}
                  <img src="{{ 'mt-card-' | append: block.settings.art | append: '.webp' | asset_url }}" alt="" width="360" height="360" loading="lazy">
                {%- endif -%}
              </span>
            {%- elsif media != 'icon' and block.settings.icon != 'none' -%}
              <span class="mt-card-photo mt-card-photo--icon">{%- render 'mt-icon', icon: block.settings.icon -%}</span>
            {%- elsif numbered -%}
              <span class="mt-card-num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            {%- else -%}
              {%- render 'mt-icon', icon: block.settings.icon -%}
            {%- endif -%}
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            {%- if block.settings.pill != blank -%}<span class="mt-card-pill">{{ block.settings.pill | escape }}</span>{%- endif -%}
            {%- if block.settings.link_label != blank -%}
              {%- capture href -%}{% render 'mt-link-to', key: block.settings.link_to, url: block.settings.link %}{%- endcapture -%}
              <a class="mt-link mt-card-link" href="{{ href }}">{{ block.settings.link_label | escape }}{%- render 'mt-icon', icon: 'arrow-right' -%}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.ticks != blank -%}
      {%- assign ticks = section.settings.ticks | newline_to_br | split: '<br />' -%}
      <ul class="mt-ic-ticks" role="list">
        {%- for t in ticks -%}{%- assign t = t | strip -%}{%- if t != blank -%}<li>{%- render 'mt-icon', icon: 'check' -%}<span>{{ t | escape }}</span></li>{%- endif -%}{%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.note != blank -%}<div class="mt-ic-note{% if section.settings.note_style == 'warn' %} mt-ic-note--warn{% endif %}">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</section>

