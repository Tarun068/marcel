        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clinical responsibility"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "OSMF is a complex condition requiring appropriate assessment, and individual responses to care can vary."
        },
