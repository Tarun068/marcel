        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "tight",
          "label": "Compact"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "tight"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
