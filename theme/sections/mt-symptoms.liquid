      "default": "illustrated"
    },
    {
      "type": "checkbox",
      "id": "photos",
      "label": "Show the built-in symptom photos",
      "info": "Photos for mouth opening, burning, tightness, pain, ulcers, white bands and tongue. A photo chosen on a symptom replaces its built-in one.",
      "default": true
