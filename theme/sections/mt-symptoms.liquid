          "settings": {
            "icon": "s-open",
            "title": "Difficulty opening mouth",
            "short": "Your mouth no longer opens as wide as before.",
            "text": "Your jaw doesn’t open as wide as it used to, and even a two-finger gap starts to feel like a stretch. Mouth opening is the main measure used to describe the stage of OSMF."
          }
        },
        {
          "type": "symptom",
          "settings": {
            "icon": "s-burn",
            "title": "Burning while eating",
            "short": "Spicy or sour food stings more than it used to.",
            "text": "A sharp, burning feeling that flares up with spicy or sour food. If everyday meals have started to sting, the inside of your mouth needs a closer look."
          }
        },
