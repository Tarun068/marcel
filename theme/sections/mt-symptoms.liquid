    {
      "type": "header",
      "content": "Last tile"
    },
    {
      "type": "text",
      "id": "tile_title",
      "label": "Title",
      "default": "Good to know"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Text",
      "default": "These signs often build up slowly, and some can have other causes. If any of them last more than two weeks or keep coming back, have your mouth checked."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "info": "Optional. The panel on the right already has a button."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link",
      "info": "Empty uses the self-check page from Theme settings."
    },
    {
      "type": "header",
      "content": "Detail panel"
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Counter",
      "info": "[n] is the number selected, [total] the number of symptoms.",
      "default": "[n] of [total] selected."
    },
    {
      "type": "text",
      "id": "msg_none",
      "label": "Message when none selected",
      "default": "Tap each symptom you have noticed in the last few months."
    },
    {
      "type": "text",
      "id": "msg_one",
      "label": "Message for one",
      "default": "One sign on its own can be mild. The self-check will tell you more."
    },
    {
      "type": "text",
      "id": "msg_few",
      "label": "Message for a few",
      "info": "[n] is the number selected.",
      "default": "[n] signs together are worth checking. Take the self-check to see your likely stage."
    },
    {
      "type": "text",
      "id": "msg_many",
      "label": "Message for many",
      "info": "[n] is the number selected.",
      "default": "[n] signs together can point to a later stage. Please take the self-check and talk to an expert soon."
    },
    {
      "type": "range",
      "id": "many_from",
      "label": "Show the \"many\" message from",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "detail_button_label",
