{{ 'mt-symptoms.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mt-symptoms.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cta_link = section.settings.cta_link | default: settings.mt_link_test | default: routes.root_url
  assign detail_link = section.settings.detail_button_link | default: settings.mt_link_test | default: routes.root_url
  assign first = section.blocks.first
  assign total = section.blocks.size
  assign count_text = section.settings.count_text | replace: '[n]', '0' | replace: '[total]', total
  assign art = false
  if section.settings.icon_style == 'illustrated'
    assign art = true
  endif
  assign first_art = false
  assign first_pre = first.settings.icon | slice: 0, 2
  if art and first_pre == 's-'
    assign first_art = true
  endif

  # The panel opens on the first symptom: its own photo, else the built-in photo for its icon.
  assign first_photo = ''
  if first.settings.image != blank
    assign first_photo = first.settings.image | image_url: width: 720
  elsif section.settings.photos
    capture first_key
      render 'mt-symptom-photo', icon: first.settings.icon
    endcapture
    if first_key != blank
      assign first_photo = 'mt-symptom-' | append: first_key | append: '-720.webp' | asset_url
    endif
  endif
-%}
{%- if art -%}{% render 'mt-symptom-art' %}{%- endif -%}

<section class="{% render 'mt-section-class', s: section.settings, extra: 'mt-symptoms' %}">
  <div class="mt-wrap">
    {%- render 'mt-sec-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}

    {%- if total > 0 -%}
      <mt-symptoms
        class="mt-sym-layout"
        data-count-text="{{ section.settings.count_text | escape }}"
        data-msg-none="{{ section.settings.msg_none | escape }}"
        data-msg-one="{{ section.settings.msg_one | escape }}"
        data-msg-few="{{ section.settings.msg_few | escape }}"
        data-msg-many="{{ section.settings.msg_many | escape }}"
        data-many-from="{{ section.settings.many_from }}"
      >
        <div class="mt-sym-grid">
          {%- for block in section.blocks -%}
            {%- liquid
              assign pre = block.settings.icon | slice: 0, 2
              assign use_art = false
              if art and pre == 's-'
                assign use_art = true
              endif
              assign photo_key = ''
              assign photo = ''
              if block.settings.image != blank
                assign photo = block.settings.image | image_url: width: 720
              elsif section.settings.photos
                capture photo_key
                  render 'mt-symptom-photo', icon: block.settings.icon
                endcapture
                if photo_key != blank
                  assign photo = 'mt-symptom-' | append: photo_key | append: '-720.webp' | asset_url
                endif
              endif
            -%}
            <button
              type="button"
              class="mt-sym{% if photo != blank %} mt-sym--photo{% endif %}{% if forloop.first %} is-viewing{% endif %}"
              aria-pressed="false"
              data-icon="{{ block.settings.icon }}"
              data-art="{{ use_art }}"
              data-photo="{{ photo }}"
              data-title="{{ block.settings.title | escape }}"
              data-text="{{ block.settings.text | escape }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <span class="mt-sym-img">{{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 360, 480', sizes: '(min-width: 921px) 200px, 45vw', alt: '' }}</span>
              {%- elsif photo_key != blank -%}
                {%- assign photo_small = 'mt-symptom-' | append: photo_key | append: '-480.webp' | asset_url -%}
                <span class="mt-sym-img"><img src="{{ photo_small }}" srcset="{{ photo_small }} 480w, {{ photo }} 720w" sizes="(min-width: 921px) 200px, 45vw" width="720" height="540" alt="" loading="lazy"></span>
              {%- elsif use_art -%}
                <span class="mt-sym-art"><svg viewBox="0 0 80 80" aria-hidden="true" focusable="false"><use href="#mt-sx-{{ block.settings.icon }}"/></svg></span>
              {%- else -%}
                <span class="mt-sym-ico">{%- render 'mt-icon', icon: block.settings.icon -%}</span>
              {%- endif -%}
              <span class="mt-sym-txt">
                {%- comment -%} The tick sits beside the title on photo tiles, so it never covers the photo. {%- endcomment -%}
                <span class="mt-sym-tick">{%- render 'mt-icon', icon: 'check' -%}</span>
                <b>{{ block.settings.title | escape }}</b>
                {%- if block.settings.short != blank -%}<small>{{ block.settings.short | escape }}</small>{%- endif -%}
              </span>
            </button>
          {%- endfor -%}
          {%- if section.settings.tile_title != blank or section.settings.cta_text != blank or section.settings.cta_label != blank -%}
            <div class="mt-sym-cta">
              {%- if section.settings.tile_title != blank -%}
                <b>{%- render 'mt-icon', icon: 'info' -%}{{ section.settings.tile_title | escape }}</b>
              {%- endif -%}
              {%- if section.settings.cta_text != blank -%}<span>{{ section.settings.cta_text | escape }}</span>{%- endif -%}
              {%- if section.settings.cta_label != blank -%}
                <a class="mt-link" href="{{ cta_link }}">
                  {{- section.settings.cta_label | escape -}}
                  {%- render 'mt-icon', icon: 'arrow-right' -%}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <aside class="mt-sym-detail" aria-live="polite">
          <span class="mt-sym-detail-photo" data-mt-photo{% if first_photo == blank %} hidden{% endif %}>
            {%- if first_photo != blank -%}
              <img src="{{ first_photo }}" width="720" height="540" alt="" loading="lazy">
            {%- else -%}
              <img width="720" height="540" alt="" loading="lazy">
            {%- endif -%}
          </span>
          <span class="mt-sym-detail-ico{% if first_art %} is-art{% endif %}" data-mt-ico{% if first_photo != blank %} hidden{% endif %}>
            {%- if first_art -%}
              <svg viewBox="0 0 80 80" aria-hidden="true" focusable="false"><use href="#mt-sx-{{ first.settings.icon }}"/></svg>
            {%- else -%}
              <svg class="mt-i" aria-hidden="true" focusable="false"><use href="#mt-i-{{ first.settings.icon }}"/></svg>
            {%- endif -%}
          </span>
          <h3 data-mt-title>{{ first.settings.title | escape }}</h3>
          <p data-mt-text>{{ first.settings.text | escape }}</p>
          <div class="mt-sym-meter">
            <div class="mt-sym-bars" style="--mt-cols: {{ total }};">
              {%- for block in section.blocks -%}<i></i>{%- endfor -%}
            </div>
            <p>
              <b data-mt-count>{{ count_text | escape }}</b>
              <span data-mt-msg>{{ section.settings.msg_none | escape }}</span>
            </p>
          </div>
          {%- if section.settings.detail_button_label != blank -%}
            <div class="mt-btn-row">
              <a class="mt-btn mt-btn-light" href="{{ detail_link }}">
                {{- section.settings.detail_button_label | escape -}}
                {%- render 'mt-icon', icon: 'arrow-right' -%}
              </a>
            </div>
          {%- endif -%}
        </aside>
      </mt-symptoms>
    {%- else -%}
      <p class="mt-placeholder">Add "Symptom" blocks to build the grid.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Marcel symptoms",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 12,
