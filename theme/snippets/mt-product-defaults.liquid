{%- comment -%}
  Outputs fallback card details for the MARCEL products and kits, matched on the handle, as
  "role|color|meta|best|benefit;benefit;benefit". Used only where the product's "marcel" metafields are empty,
  so products imported from setup/products.csv look right before any metafields are filled in.

  Accepts:
  - product: {Object} product

  Usage:
  {%- capture defaults -%}{% render 'mt-product-defaults', product: product %}{%- endcapture -%}
{%- endcomment -%}
{%- liquid
  assign h = product.handle | downcase
  # Ora-Care and Ora-Shield carry no badge: Foundation and Advance are the kits, sold as their own products.
  if h contains 'shield'
    echo '|#5A5CBE|Therapeutic oral rinse, 10 mL|Advance Kit pathway|Part of the MARCEL OMR Therapy™ Advance Kit;A concentrate, diluted before use;Used with professional guidance'
  elsif h contains 'ora-care' or h contains 'oracare'
    echo '|#168C83|Metered oral spray, 50 mL|Foundation Kit pathway|Part of the MARCEL OMR Therapy™ Foundation Kit;May support the management of burning and tightness;A measured amount with every spray'
  elsif h contains 'smile'
    echo 'Daily oral care|#2265C4|Toothpaste in 30 g and 100 g packs|Everyday care|Premium herbal complex;No SLS, no parabens;No artificial sweeteners'
  elsif h contains 'mo-device' or h contains 'moflex'
    echo 'Optional adjunct|#077C87|Mouth-opening support device|When recommended|Supports guided mouth-opening exercises;Gentle and gradual, never forced.;Used with professional guidance'
  elsif h contains 'foundation'
    echo 'Stage 1 or 2|#168C83|Oral spray and toothpaste kit|Foundation pathway|MARCEL Ora-Care™ Oral Spray;MARCEL Smile™ Toothpaste;Use as advised by a healthcare professional'
  elsif h contains 'advance'
    echo 'Stage 3 or 4|#5A5CBE|Oral rinse and toothpaste kit|Advance pathway|MARCEL Ora-Shield™ Oral Rinse;MARCEL Smile™ Toothpaste;Use as advised by a healthcare professional'
  endif
-%}
