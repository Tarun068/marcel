{%- comment -%}
  Marcel logo: the uploaded image, or the hexagon mark with the brand words from Theme settings > Marcel brand.

  Accepts:
  - image: {Object} image to show (optional)
  - light: {Boolean} use the white mark for dark backgrounds
  - tagline: {Boolean} show the tagline line under the words
  - sizes: {String} sizes attribute for the image (optional)
  - crop_left, crop_top, crop_width, crop_height: {Number} region of the image to show, in image pixels, to trim
    white space built into the logo file (optional; Shopify crops the image on the CDN)

  Usage:
  {% render 'mt-logo', image: section.settings.logo, tagline: true %}
{%- endcomment -%}
{%- if image != blank and crop_width > 0 and crop_height > 0 -%}
  {%- liquid
    assign logo_widths = '160,240,320,480,600' | split: ','
    assign logo_h = 600 | times: crop_height | divided_by: crop_width
    capture logo_srcset
      for w in logo_widths
        assign wn = w | plus: 0
        echo image | image_url: width: wn, crop: 'region', crop_left: crop_left, crop_top: crop_top, crop_width: crop_width, crop_height: crop_height
        echo ' ' | append: w | append: 'w'
        unless forloop.last
          echo ', '
        endunless
      endfor
    endcapture
  -%}
  <img
    class="mt-logo-img"
    src="{{ image | image_url: width: 600, crop: 'region', crop_left: crop_left, crop_top: crop_top, crop_width: crop_width, crop_height: crop_height }}"
    srcset="{{ logo_srcset }}"
    {% if sizes != blank %}
      sizes="{{ sizes }}"
    {% endif %}
    width="600"
    height="{{ logo_h }}"
    alt="{{ shop.name | escape }}"
    loading="eager"
  >
{%- elsif image != blank -%}
  {{
    image
    | image_url: width: 600
    | image_tag: class: 'mt-logo-img', alt: shop.name, loading: 'eager', widths: '160, 240, 320, 480, 600', sizes: sizes
  }}
{%- else -%}
  <span class="mt-logo-fb{% if light %} mt-logo-fb--light{% endif %}">
    <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><use href="#mt-logo-mark{% if light %}-light{% endif %}"/></svg>
    <span class="mt-logo-words">
      <b>
        {{- settings.mt_brand_name | escape -}}
        {%- if settings.mt_brand_symbol != blank -%}<sup>{{ settings.mt_brand_symbol | escape }}</sup>{%- endif -%}
      </b>
      {%- if settings.mt_brand_line != blank -%}<span>{{ settings.mt_brand_line | escape }}</span>{%- endif -%}
      {%- if tagline and settings.mt_brand_tagline != blank -%}<small>{{ settings.mt_brand_tagline | escape }}</small>{%- endif -%}
    </span>
  </span>
{%- endif -%}
