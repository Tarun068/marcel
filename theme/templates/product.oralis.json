    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is MARCEL OraLis?",
            "answer": "<p>MARCEL OraLis is a proprietary Ayurvedic herbal mouthwash, designed to complement your daily oral hygiene routine.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How do I use MARCEL OraLis?",
            "answer": "<p>Rinse with 10 mL (about 2 capfuls) for 30 to 60 seconds, then spit out. Use twice daily. Do not swallow.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What is in MARCEL OraLis?",
            "answer": "<p>Triphala, Bakula, Khadir, Yashtimadhu and Majuphal extracts, with peppermint, spearmint and Japanese mint oils and natural menthol, in an aqueous base. The full composition is listed on this page and on the pack.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Does MARCEL OraLis treat or cure any condition?",
            "answer": "<p>No. It is not intended to diagnose, treat, cure or prevent any disease. If symptoms persist, consult a physician.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Can I swallow it?",
            "answer": "<p>No. MARCEL OraLis is for external use only. Do not swallow it, and use it under medical supervision.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "How should I store it?",
            "answer": "<p>Store it in a cool, dry place and protect it from light. Keep it out of reach of children. Use within 24 months from the date of manufacture.</p>"
          }
        }
      },
