    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is MARCEL OraLis?",
            "answer": "<p>MARCEL OraLis is a herbal mouthwash designed to complement daily oral hygiene. It helps maintain oral cleanliness, freshens breath and leaves the mouth feeling clean and refreshed.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How do I use MARCEL OraLis?",
            "answer": "<p>Rinse with 10 mL (about 2 capfuls) for 30 to 60 seconds, then spit out. Do not swallow.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How often should I use MARCEL OraLis?",
            "answer": "<p>Use it twice daily, or as directed by an Ayurvedic physician.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Should I swallow the mouthwash?",
            "answer": "<p>No. Spit it out after rinsing. Do not swallow.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Does MARCEL OraLis replace brushing?",
            "answer": "<p>No. A mouthwash complements your daily oral hygiene routine. It does not replace brushing and cleaning between the teeth.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Is MARCEL OraLis alcohol free?",
            "answer": "<p>Yes. MARCEL OraLis is free from alcohol, SLS, artificial colours and artificial sweeteners. Please check the pack label for the complete ingredient and product information.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "What is in MARCEL OraLis?",
            "answer": "<p>Triphala, Bakula, Khadir, Yashtimadhu and Majuphal extracts, with peppermint, spearmint and Japanese mint oils and natural menthol, in an aqueous base. The full composition is listed on the pack.</p>"
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "Can MARCEL OraLis prevent or treat OSMF?",
            "answer": "<p>No. MARCEL OraLis is a mouthwash for daily oral hygiene and has not been shown to prevent or treat OSMF. Anyone with mouth tightness, burning, reduced mouth opening, persistent ulcers or suspected OSMF should be assessed by a qualified healthcare professional.</p>"
          }
        },
        "question_9": {
          "type": "question",
          "settings": {
            "question": "Can I use it if I have OSMF or oral symptoms?",
            "answer": "<p>Ask your treating dentist or physician whether it suits your situation. A mouthwash does not replace OSMF assessment, stopping risk habits or care directed by your clinician.</p>"
          }
        },
        "question_10": {
          "type": "question",
          "settings": {
            "question": "How should I store it?",
            "answer": "<p>Store it in a cool, dry place and protect it from light. Keep it out of reach of children. Use within 24 months from the date of manufacture.</p>"
          }
        },
        "question_11": {
          "type": "question",
          "settings": {
            "question": "What is the pack size?",
            "answer": "<p>MARCEL OraLis comes in a 250 mL pack. The current price is shown at the top of this page.</p>"
          }
        }
      },
