    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Is the MARCEL® MOFlex Device required for every patient?",
            "answer": "<p>No. It is an optional support tool and may be considered for selected individuals based on their needs and mouth-opening status.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Can I use the device on its own?",
            "answer": "<p>It is not a standalone solution. It is intended to support guided exercises as part of a broader care and rehabilitation plan.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Will it increase mouth opening immediately?",
            "answer": "<p>No immediate or guaranteed result should be expected. Progress, if any, is individual and may be gradual.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Should I force my mouth open while using it?",
            "answer": "<p>No. Do not force movement. Follow the final approved instructions and personalised guidance from a qualified healthcare professional.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "How do I know whether it is suitable for me?",
            "answer": "<p>Discuss your mouth-opening status and exercise needs with a MARCEL OSMF Consultant.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Where does it fit within MARCEL OMR Therapy™?",
            "answer": "<p>It may be used as an optional adjunct in the functional-rehabilitation component of the MARCEL OMR Therapy™ Advance Kit programme, where appropriate.</p>"
          }
        }
      },
