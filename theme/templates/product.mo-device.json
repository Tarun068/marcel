    "use": {
      "type": "mt-media-text",
      "settings": {
        "art": "device",
        "media_side": "left",
        "eyebrow": "How it is used",
        "heading": "Support for Your <em>Exercise Routine</em>",
        "text": "<p>The MARCEL® MOFlex Device is an optional aid for guided mouth-opening exercises. Use it only in the way your healthcare professional shows you, and never force your mouth open.</p>",
        "points": "",
        "button_1_label": "Book a Consultation",
        "button_1_to": "consult",
