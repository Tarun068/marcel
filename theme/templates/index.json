    "symptoms": {
      "type": "mt-symptoms",
      "blocks": {
        "symptom_1": {
          "type": "symptom",
          "settings": {
            "icon": "s-open",
            "title": "Difficulty Opening Mouth",
            "short": "Your mouth no longer opens as wide as before.",
            "text": "Your jaw doesn’t open as wide as it used to, and even a two-finger gap starts to feel like a stretch. Mouth opening is the main measure used to describe the stage of OSMF."
          }
        },
        "symptom_2": {
          "type": "symptom",
          "settings": {
            "icon": "s-burn",
            "title": "Burning While Eating",
            "short": "Spicy or sour food stings more than it used to.",
            "text": "A sharp, burning feeling that flares up with spicy or sour food. If everyday meals have started to sting, the inside of your mouth needs a closer look."
          }
        },
        "symptom_3": {
          "type": "symptom",
          "settings": {
            "icon": "s-tight",
            "title": "Tightness Inside Mouth",
            "short": "Cheeks or lips feel stiff and less flexible.",
            "text": "A stiff, band-like tightness across the cheeks or inner lips, as if the tissue has less give. Doctors check for this tightening during an oral exam."
          }
        },
        "symptom_4": {
          "type": "symptom",
          "settings": {
            "icon": "s-ulcer",
            "title": "Ulcers",
            "short": "Sores or raw patches that are slow to heal.",
            "text": "Small sores or raw patches that last longer than a normal mouth ulcer. Any ulcer that doesn’t heal within two weeks should be checked by a doctor."
          }
        },
        "symptom_5": {
          "type": "symptom",
          "settings": {
            "icon": "s-bands",
            "title": "White Bands",
            "short": "Pale, firm streaks along the cheeks or gums.",
            "image": "shopify://shop_images/whiteband.jpg",
            "text": "Pale, fibrous streaks or patches along the cheeks or gums. They can feel leathery to the touch and are a common sign of tissue changes."
          }
        },
        "symptom_6": {
          "type": "symptom",
          "settings": {
            "icon": "s-tongue",
            "title": "Reduced Tongue Movement",
            "short": "Harder to stick out or move your tongue.",
            "text": "Trouble sticking your tongue out fully or moving it from side to side. A tongue that feels tied down is worth mentioning to a doctor."
          }
        },
        "symptom_7": {
          "type": "symptom",
          "settings": {
            "icon": "s-pain",
            "title": "Pain While Eating",
            "short": "Chewing hurts, especially harder foods.",
            "text": "Discomfort or pain while chewing, especially with harder or drier foods. If mealtimes have started to hurt, don’t ignore it."
          }
        },
