    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What are the early signs of OSMF?",
            "answer": "<p>Burning while eating spicy food, tightness inside the cheeks and gradually reduced mouth opening can be signs of OSMF. If these symptoms persist or are getting worse, arrange a professional assessment.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "What is MARCEL OMR Therapy?",
            "answer": "<p>MARCEL OMR Therapy is a structured approach to oral mucosal care, designed around a planned care journey rather than using products at random. The appropriate care plan depends on the person’s needs and the approved instructions for each product.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What is the difference between a MARCEL OSMF Consultant and an OSMF Specialist Doctor?",
            "answer": "<p>A MARCEL OSMF Consultant provides an on-call consultation, allowing you to discuss your concerns and understand the next step remotely. An OSMF Specialist Doctor provides an in-clinic, in-person consultation, where the doctor can examine your mouth, assess mouth opening and evaluate oral tissue changes directly.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3"
