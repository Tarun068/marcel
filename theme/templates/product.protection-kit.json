    "routine": {
      "type": "mt-use-steps",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Brush with MARCEL Smile",
            "text": "Brush thoroughly for <strong>at least two minutes</strong>. Preferably use it <strong>twice daily</strong>, or as directed by your dental or healthcare professional. <em>Do not swallow.</em>",
            "art": "brush"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Rinse with MARCEL OraLis",
            "text": "Rinse with <strong>10 mL</strong>, about <strong>2 capfuls</strong>, for <strong>30 to 60 seconds</strong>, then spit out. <em>Do not swallow.</em>",
            "art": "rinse"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Keep Up the Routine",
            "text": "Use MARCEL OraLis <strong>twice daily</strong> or as directed by an Ayurvedic physician. Keep brushing regularly and cleaning between your teeth.",
            "art": "repeat"
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3"
      ],
      "settings": {
