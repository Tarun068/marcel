    "awareness": {
      "type": "mt-awareness",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "qid": "q1",
            "text": "Do you consume gutkha, pan masala, supari (areca nut), khaini, mawa, padiki, tobacco, or any other product containing supari or tobacco?",
            "options": "yes | Yes\nno | No"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "qid": "q2",
            "text": "Do you believe that your habit will not cause you any health problems in the future?",
            "options": "yes | Yes\nno | No\nunsure | Not sure"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "qid": "q3",
            "text": "Do you believe that because many elders consumed tobacco or supari for years without any obvious illness, the same will be true for you?",
            "options": "yes | Yes\nno | No\nunsure | Not sure"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "qid": "q4",
            "text": "Are you aware of how serious the health problems associated with consuming supari or tobacco can be?",
            "options": "yes | Yes\nno | No\nunsure | Not sure"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "qid": "q5",
            "text": "Have you ever tried to quit this habit?",
            "options": "yes | Yes\nno | No\ntried | Tried, but couldn’t quit"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "qid": "q6",
            "text": "Do you know that this habit can lead to conditions such as Oral Submucous Fibrosis (OSMF), difficulty opening the mouth, persistent oral ulcers and oral cancer?",
            "options": "yes | Yes\nno | No\nunsure | Not sure"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "qid": "q7",
            "text": "Are you willing to take steps today to quit this habit and protect your oral health, rather than wait for symptoms or health problems to appear?",
            "options": "ready | Yes, I am ready\nhelp | I need help\nnotready | Not ready yet"
          }
        },
        "question_8": {
          "type": "changes",
          "settings": {
            "text": "Have you noticed any of the following changes in your mouth?",
            "help": "Select all that apply. If none, select “None of these”.",
            "options": "Burning while eating spicy food\nCheek tightness or stiffness\nDifficulty opening the mouth\nPersistent oral ulcers\nUnusual red or white patches\nNone of these"
          }
        }
      },
      "block_order": [
        "question_1",
