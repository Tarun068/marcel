    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is the MARCEL OMR Therapy Protection Kit?",
            "answer": "<p>It is a two-product daily oral-care combination containing MARCEL OraLis Herbal Mouthwash (250 mL) and MARCEL Smile Therapeutic Toothpaste (30 g).</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Who is this kit intended for?",
            "answer": "<p>It is a two-product daily oral-care kit. People who use gutkha, mawa, pan masala, supari or tobacco should make quitting their priority and arrange a professional oral examination. The kit is not a substitute for either step.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Does the Protection Kit prevent OSMF?",
            "answer": "<p>No. The kit has not been shown to prevent OSMF or reduce the risk of developing it. It should never be a reason to continue tobacco or areca nut use.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Can I continue using gutkha or supari if I use this kit?",
            "answer": "<p>No oral-care product makes continued gutkha, tobacco or areca nut use safe. The important step is to stop using these products and to seek help if you find quitting difficult.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "How do I use MARCEL OraLis?",
            "answer": "<p>Rinse with 10 mL (about 2 capfuls) for 30 to 60 seconds, then spit out. Do not swallow. Use twice daily or as directed by an Ayurvedic physician, following the product label.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "How do I use MARCEL Smile?",
            "answer": "<p>Brush thoroughly for at least two minutes, preferably twice daily or as directed by your dental or healthcare professional. Follow the directions on the pack and do not swallow.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "Should I wait until symptoms appear before getting examined?",
            "answer": "<p>No. If you use tobacco or areca nut products, take the risks seriously and ask a professional about an oral examination. Persistent burning, tightness, reduced mouth opening, ulcers or unusual red or white patches need prompt assessment.</p>"
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "Can this kit replace OSMF treatment or a dental examination?",
            "answer": "<p>No. It is a daily oral-care combination, not an OSMF treatment programme. It does not replace clinical assessment, diagnosis, quitting risk habits or any treatment recommended by a qualified professional.</p>"
          }
        }
      },
