      "settings": {
        "eyebrow": "",
        "heading": "What Matters Most Is Taking the Right Next Step",
        "subheading": "",
        "text": "If you use gutkha, mawa, pan masala, supari or tobacco, do not wait for symptoms before taking your oral health seriously.",
        "center": false,
        "columns": "3",
        "media": "icon",
        "card_style": "numbered",
        "accent": "green",
        "intro_badge": "",
        "intro_title": "",
        "intro_text": "",
        "intro_note": "",
        "ticks": "",
        "note": "<p><strong>Important:</strong> The Protection Kit is a daily oral-care combination. It has not been established as preventing OSMF, reversing fibrosis, neutralising the effects of tobacco or areca nut, or making continued use safe. It does not replace quitting, oral examination, diagnosis or medical and dental care. Persistent burning, cheek tightness, reduced mouth opening, a non-healing ulcer, or unusual red or white patches need professional assessment.</p>",
        "note_style": "warn",
        "background": "paper",
        "sheet": false,
        "spacing": "normal"
