        "question_1": {
          "type": "question",
          "settings": {
            "question": "How do I use MARCEL Smile?",
            "answer": "<p>Take a pea-sized amount. Brush thoroughly for at least two minutes, preferably twice daily, or as directed by a qualified professional. Spit out and rinse your mouth with water.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "What is inside MARCEL Smile?",
            "answer": "<ul><li>Premium Herbal Complex, a blend of plant extracts</li><li>Natural flavors</li><li>No artificial sweeteners, for a naturally pleasant taste</li><li>No parabens, so no synthetic preservatives</li><li>No SLS, a harsh foaming agent</li></ul>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Which pack size should I choose?",
            "answer": "<p>The 30 g pack is compact and handy for travel. The 100 g pack is the larger pack and the best value for home.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Why care for the soft tissues in my mouth?",
            "answer": "<p>Teeth, gums, enamel and fresh breath all matter, and so do the soft tissues lining the inside of your mouth. MARCEL Smile brings these tissues into your daily oral care, so your routine looks after more than just teeth and gums.</p>"
          }
        }
      },
