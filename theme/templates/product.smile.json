    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is MARCEL Smile Toothpaste?",
            "answer": "<p>MARCEL Smile is a therapeutic toothpaste designed for everyday oral care. It supports oral mucosal health, healthy gums and strong enamel, and helps keep teeth strong and breath fresh.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "What are the key product features?",
            "answer": "<p>MARCEL Smile is made with real herbal extracts and natural flavours, with no artificial sweeteners and no SLS or parabens. See the carton for the complete declared product information.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What pack sizes are available?",
            "answer": "<p>MARCEL Smile is available in 30 g and 100 g packs.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How should I use MARCEL Smile?",
            "answer": "<p>Follow the directions printed on the pack or the advice of your dental or healthcare professional.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Can MARCEL Smile replace professional dental care?",
            "answer": "<p>No. MARCEL Smile is a toothpaste for everyday oral care. It does not replace professional dental assessment, diagnosis or treatment.</p>"
          }
        }
      },
