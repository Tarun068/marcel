    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is the MARCEL OMR Therapy Foundation Kit?",
            "answer": "<p>It is a structured oral-care kit for patients assessed by their treating healthcare professional as suitable within the Stage 1 and Stage 2 OSMF framework. It brings together MARCEL OraCare Oral Spray and MARCEL Smile Toothpaste.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "What is included in the Foundation Kit?",
            "answer": "<p>The two core products are MARCEL OraCare Therapeutic Oral Spray (50 mL) and MARCEL Smile Toothpaste (30 g). MARCEL® MOFlex is an optional adjunct and is not included in the two-product kit.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How do I use OraCare Oral Spray?",
            "answer": "<p>Apply 6 to 7 puffs evenly throughout the mouth to ensure complete coverage of the oral tissues. Use twice daily. Follow the product label and advice from your treating professional.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "What is the role of Smile Toothpaste?",
            "answer": "<p>Smile is the daily oral-hygiene component of the kit. Brush thoroughly for at least two minutes, preferably twice daily or as directed by an Oral Care Expert, dentist or physician. Rinse thoroughly after brushing and do not swallow.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Is MOFlex included in the Foundation Kit?",
            "answer": "<p>No. MARCEL® MOFlex is optional and separate from the two core kit products. It should only be recommended after an individual professional assessment and used with proper instructions.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Does the Foundation Kit cure OSMF?",
            "answer": "<p>No cure or guaranteed reversal claim is made. The kit is part of a structured oral-care approach and does not replace diagnosis, individualised treatment planning or indicated medical and dental management.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "Why is professional assessment important?",
            "answer": "<p>OSMF stage and suitability cannot be established from symptoms alone. A qualified healthcare professional should assess your condition and decide on the right care, investigations and referral.</p>"
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "What is the 12-week care journey?",
            "answer": "<p>It is a framework organised into Relief (Weeks 1 and 2), Activation (Weeks 3 to 6), Restoration (Weeks 6 to 10) and Reinforcement (Weeks 11 and 12). It is not a guarantee of a particular clinical outcome.</p>"
          }
        },
        "question_9": {
          "type": "question",
          "settings": {
            "question": "When should I seek prompt medical or dental review?",
            "answer": "<p>Seek timely professional evaluation for persistent oral ulcers, suspicious oral changes, worsening symptoms or significant difficulty opening your mouth.</p>"
          }
        }
      },
