    "promo": {
      "type": "mt-promo-card",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "title": "Burning While Eating",
            "text": "Burning or irritation may be noticed inside the mouth, particularly when eating spicy, hot or strongly flavoured foods."
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "title": "Increased Sensitivity Inside the Mouth",
            "text": "The lining of the cheeks or other areas inside the mouth may feel sensitive or uncomfortable, even when there is no obvious sore."
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "title": "Pale or Whitish Areas Inside the Cheeks",
            "text": "Some people notice that the inner cheek lining looks paler or has whitish changes. These changes need examination and should not be self-diagnosed."
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "title": "Early Tightness of the Cheeks",
            "text": "The cheeks may begin to feel less flexible, with a mild pulling or tight sensation when stretching the mouth."
          }
        },
        "item_5": {
          "type": "item",
          "settings": {
            "title": "Early Change in Mouth Opening",
            "text": "You may notice a small change when opening wide, yawning or taking a large bite. Marked restriction needs clinical assessment."
          }
        },
        "item_6": {
          "type": "item",
          "settings": {
            "title": "Mild Discomfort While Chewing",
            "text": "Some foods may cause irritation or discomfort, although everyday chewing may still be largely unaffected."
          }
        },
        "item_7": {
          "type": "item",
          "settings": {
            "title": "Dryness or Altered Feeling in the Mouth",
            "text": "Some people report dryness, a rough feeling or other changes in how the inside of the mouth feels."
          }
        },
        "item_8": {
          "type": "item",
          "settings": {
            "title": "Early Changes May Be Subtle",
            "text": "Symptoms can come and go or be easy to overlook. A dental or medical examination is important if you notice persistent changes."
          }
        }
      },
      "block_order": [
        "item_1",
        "item_2",
        "item_3",
        "item_4",
        "item_5",
        "item_6",
        "item_7",
        "item_8"
      ],
      "settings": {
        "eyebrow": "Understanding Stage 1 & Stage 2 OSMF",
        "heading": "When Early Symptoms Begin to Affect Everyday Comfort",
        "text": "Early OSMF symptoms can be subtle. Some people notice burning while eating spicy food, a feeling of tightness inside the cheeks or changes in how widely they can open their mouth. Symptoms vary from person to person.",
        "text_2": "<p>These concerns may occur in OSMF, but symptoms alone cannot confirm the condition or determine its stage. A dentist or other qualified healthcare professional should examine the mouth and assess mouth opening and other clinical findings.</p>",
        "button_label": "",
        "button_to": "custom",
        "button_link": "",
        "art": "none",
        "numbered": true,
        "note": "<p><strong>Important:</strong> Do not ignore a persistent or unusual mouth change. A non-healing ulcer, red or white patch, lump, unexplained bleeding or worsening symptoms needs prompt examination by a dentist or doctor. Do not assume these changes are simply OSMF.</p>",
        "tone": "blue",
        "overlap": true,
        "background": "paper",
        "sheet": false,
        "spacing": "tight"
      }
