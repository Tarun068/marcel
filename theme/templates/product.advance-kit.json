    "promo": {
      "type": "mt-promo-card",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "title": "Difficulty Opening the Mouth",
            "text": "The mouth may not open as wide as before. Eating larger bites, yawning or reaching the back teeth while brushing can become difficult."
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "title": "Tight or Stiff Cheeks",
            "text": "The inside of the cheeks may feel tight, firm or less stretchy. Some people notice a pulling sensation when trying to open their mouth."
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "title": "Burning While Eating",
            "text": "Chilli, spicy foods, hot drinks or certain sour foods may cause burning or irritation inside the mouth."
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "title": "Reduced Tongue Movement",
            "text": "The tongue may feel less flexible or harder to move, stretch out or move from side to side."
          }
        },
        "item_5": {
          "type": "item",
          "settings": {
            "title": "Dryness or Changes in Taste",
            "text": "The mouth may feel unusually dry, and some people notice that food tastes different or less distinct."
          }
        },
        "item_6": {
          "type": "item",
          "settings": {
            "title": "Difficulty Chewing or Eating",
            "text": "Chewing may take longer or feel uncomfortable. Restricted mouth opening can make it harder to take bites or manage certain foods."
          }
        },
        "item_7": {
          "type": "item",
          "settings": {
            "title": "Changes in Speaking or Oral Hygiene",
            "text": "Tightness or reduced tongue movement may make some words harder to pronounce. Cleaning the teeth and inner cheeks may also become more difficult."
          }
        },
        "item_8": {
          "type": "item",
          "settings": {
            "title": "Difficulty Puffing the Cheeks or Whistling",
            "text": "Reduced flexibility of the cheeks and lips may make it harder to blow out the cheeks, whistle or stretch the lips comfortably."
          }
        }
      },
      "block_order": [
        "item_1",
        "item_2",
        "item_3",
        "item_4",
        "item_5",
        "item_6",
        "item_7",
        "item_8"
      ],
      "settings": {
        "eyebrow": "Understanding Stage 3 & Stage 4 OSMF",
        "heading": "When Mouth Tightness Starts Affecting Everyday Life",
        "text": "In more advanced OSMF, the tissues inside the cheeks, lips, tongue and other parts of the mouth may become less flexible. The experience is different for each person. Some people notice several of the concerns below; others may have only a few.",
        "text_2": "<p>These symptoms can occur in OSMF, but they do not establish the stage or confirm a diagnosis on their own. A dentist or other qualified healthcare professional needs to examine the mouth and assess mouth opening and other findings.</p>",
        "button_label": "",
        "button_to": "custom",
        "button_link": "",
        "art": "none",
        "numbered": true,
        "note": "<p><strong>Important:</strong> Do not ignore a new or persistent mouth change. A non-healing ulcer, a red or white patch, a lump, unexplained bleeding or a change that is worsening needs prompt examination by a dentist or doctor. These changes should not simply be assumed to be OSMF.</p>",
        "tone": "blue",
        "overlap": true,
        "background": "paper",
        "sheet": false,
        "spacing": "tight"
      }
    },
