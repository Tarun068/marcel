        "routine_2": {
          "type": "routine",
          "settings": {
            "title": "MARCEL Smile: Toothpaste",
            "items": "Brush thoroughly for at least two minutes.\nPreferably use twice daily, or as directed by a dentist or physician.\nRinse thoroughly after brushing.\nUse only as directed. Do not swallow."
          }
        }
