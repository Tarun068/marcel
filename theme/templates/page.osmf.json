      "settings": {
        "anchor": "what-is-osmf",
        "heading": "What Is OSMF?",
        "heading_mark": true,
        "text": "<p><strong>Oral Submucous Fibrosis (OSMF)</strong> is a long-term condition in which tissues inside the mouth can become stiff and less flexible. It may cause burning while eating spicy food and gradually limit how widely the mouth opens.</p>",
        "callout_icon": "shield-plus",
        "link_to": "specialists",
        "art": "what",
        "image_alt": "A man gently pulling down his lower lip to look inside his mouth",
        "media_shape": "arc",
        "media_side": "right",
        "background": "paper",
        "sheet": false,
        "spacing": "normal"
      }
    },
