        "text_4": {
          "type": "text",
          "settings": {
            "text": "<p>Mouth opening is the primary yardstick for the MARCEL OSMF Self-Check. It is measured between the edges of the upper and lower front teeth.</p>"
          }
        },
        "table_1": {
          "type": "table",
          "settings": {
            "head": "Stage | Mouth opening | MARCEL OMR Therapy™ pathway",
            "rows": "Stage 1 #2B9759 | More than 35 mm, with symptoms | Foundation Kit\nStage 2 #C4860B | 26 to 35 mm | Foundation Kit\nStage 3 #D5602A | 15 to 25 mm | Advance Kit\nStage 4 #C23838 | Less than 15 mm | Advance Kit\nStage 5 #C23838 | Less than 5 mm with a persistent ulcer or confirmed carcinoma | Immediate specialist consultation",
            "bold_col": 2
          }
        },
        "fine_1": {
          "type": "fine",
          "settings": {
            "text": "Difficulty moving the tongue can indicate the next stage. Only a qualified healthcare professional can confirm the diagnosis and stage."
          }
