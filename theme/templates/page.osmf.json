    "guide": {
      "type": "mt-guide",
      "disabled": true,
      "settings": {
        "show_toc": true,
        "toc_title": "On This Page",
        "read_label": "[n] min read",
        "no_articles": "Articles will appear here once they are published.",
        "card_media": "photo",
