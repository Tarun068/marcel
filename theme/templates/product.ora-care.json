    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is MARCEL OraCare?",
            "answer": "<p>MARCEL OraCare is a therapeutic oral spray included in MARCEL OMR Therapy Foundation Programme for people experiencing Stage 1 or Stage 2 OSMF.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Who is MARCEL OraCare intended for?",
            "answer": "<p>It is part of the Foundation Programme, intended for people experiencing Stage 1 or Stage 2 OSMF, subject to appropriate clinical evaluation.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How should I use MARCEL OraCare?",
            "answer": "<p>Apply 6 to 7 puffs evenly throughout the mouth to ensure complete coverage of the oral tissues.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How frequently should I use it?",
            "answer": "<p>Use it twice daily, as the product directions state, and follow your healthcare professional’s advice where it applies.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Can MARCEL OraCare be used as a standalone treatment for OSMF?",
            "answer": "<p>No. MARCEL OraCare is one component of MARCEL OMR Therapy Foundation Programme. It is not a standalone cure and does not replace professional OSMF evaluation and care.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Does MARCEL OraCare cure OSMF?",
            "answer": "<p>No. MARCEL OraCare is not claimed to cure OSMF or reverse fibrosis on its own. OSMF needs appropriate professional evaluation and follow-up.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "What if I feel irritation?",
            "answer": "<p>Stop using the product and consult a MARCEL OSMF Consultant or a qualified healthcare professional.</p>"
          }
        }
      },
