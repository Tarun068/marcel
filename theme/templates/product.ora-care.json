    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is MARCEL Ora-Care™ Oral Spray?",
            "answer": "<p>MARCEL Ora-Care™ is a metered oral spray and a core component of Foundation MARCEL OMR Therapy™. It gives a measured, repeatable application as part of a regular oral-care routine.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How can MARCEL Ora-Care™ help?",
            "answer": "<p>MARCEL Ora-Care™ is used as part of a structured oral-care routine. It may support the management of a burning sensation, tightness in the mouth and oral discomfort. Results may vary from person to person.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What is Foundation MARCEL OMR Therapy™?",
            "answer": "<p>It is the foundational care format within the MARCEL OMR Therapy™ system. MARCEL Ora-Care™ Oral Spray is its core component.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Can I use only MARCEL Ora-Care™?",
            "answer": "<p>MARCEL Ora-Care™ is one part of Foundation MARCEL OMR Therapy™. The complete routine includes:</p><ul><li>MARCEL Ora-Care™ Oral Spray</li><li>MARCEL Smile™ Toothpaste</li><li>Prescribed mouth and jaw exercises</li><li>Follow-up with your MARCEL OSMF Consultant</li></ul><p>Following only one part may leave your care routine incomplete. We recommend following the complete routine as advised by your consultant.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What makes the spray different?",
            "answer": "<p>Its metered spray system gives a measured amount with each spray, so every application is controlled and repeatable.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "What if I feel irritation?",
            "answer": "<p>Stop using the product and consult a MARCEL OSMF Consultant or a qualified healthcare professional.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "Where can I get professional guidance?",
            "answer": "<p><a href=\"/pages/osmf-consultant\" title=\"Talk to a MARCEL OSMF Consultant\">Talk to a MARCEL OSMF Consultant</a>. For a diagnosis or advice about your own care, please visit a qualified doctor or OSMF specialist.</p>"
          }
        }
