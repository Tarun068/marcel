      "settings": {
        "headline": "Foundational oral support",
        "supporting": "Therapeutic Oral Spray",
        "intro": "<p><strong>A core component of MARCEL OMR Therapy Foundation Programme.</strong></p><p>Developed to support oral comfort and the management of symptoms such as burning sensation and oral tightness associated with Stage 1 and Stage 2 Oral Submucous Fibrosis (OSMF).</p>",
        "details": "",
        "how_lines": "Spray 6 to 7 puffs evenly throughout the mouth.\nUse twice daily, or as directed by your physician or MARCEL OSMF Consultant.\nAfter each spray, do the prescribed mouth and jaw exercises.",
