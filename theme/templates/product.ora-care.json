    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is MARCEL Ora-Care?",
            "answer": "<p>MARCEL Ora-Care is a metered oral spray and a core component of MARCEL OMR Therapy Foundation Kit. It gives a measured, repeatable application as part of a regular oral care routine.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Who is MARCEL Ora-Care intended for?",
            "answer": "<p>It is for people with Stage 1 and Stage 2 OSMF, as part of MARCEL OMR Therapy Foundation Kit. A MARCEL OSMF Consultant can assess you and help decide which care approach is suitable.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How should I use MARCEL Ora-Care?",
            "answer": "<p>Spray 6 to 7 puffs evenly throughout the mouth. Use twice daily, or as directed by your physician or MARCEL OSMF Consultant. Do the prescribed mouth and jaw exercises after each spray.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How can MARCEL Ora-Care help?",
            "answer": "<p>MARCEL Ora-Care is used as part of a structured oral care routine. It may support the management of a burning sensation, tightness in the mouth and oral discomfort. Results may vary from person to person.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What makes the spray different?",
            "answer": "<p>Its metered spray system gives a measured amount with each spray, so every application is controlled and repeatable.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Can MARCEL Ora-Care be used alone?",
            "answer": "<p>MARCEL Ora-Care is one part of MARCEL OMR Therapy Foundation Kit. The complete routine includes:</p><ul><li>MARCEL Ora-Care Oral Spray</li><li>MARCEL Smile Toothpaste</li><li>Prescribed mouth and jaw exercises</li><li>Follow-up with your MARCEL OSMF Consultant</li></ul><p>Following only one part may leave your care routine incomplete. We recommend following the complete routine as advised by your consultant.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "Does MARCEL Ora-Care cure OSMF?",
            "answer": "<p>A complete cure or a return to exactly the same mouth opening cannot be promised. The focus is to assess the condition, address symptoms and work toward the best achievable function for the individual. A qualified OSMF Specialist Doctor can explain the options after assessing the case.</p>"
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "What if I feel irritation?",
            "answer": "<p>Stop using the product and consult a MARCEL OSMF Consultant or a qualified healthcare professional.</p>"
          }
        }
      },
