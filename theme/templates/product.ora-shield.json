    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is MARCEL OraShield?",
            "answer": "<p>MARCEL OraShield is a therapeutic oral rinse and a core component of MARCEL OMR Therapy Advance Programme for Stage 3 and Stage 4 OSMF.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Who is MARCEL OraShield intended for?",
            "answer": "<p>It is included in the Advance Programme for people experiencing Stage 3 or Stage 4 Oral Submucous Fibrosis (OSMF). Please discuss whether it suits you with a qualified doctor.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How should I use MARCEL OraShield?",
            "answer": "<p>Dilute 5 to 10 drops in about 160 mL of lukewarm water. Rinse and gargle for 20 to 30 seconds, then spit out. Do not swallow.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How frequently should I use it?",
            "answer": "<p>Twice daily, or as advised by your MARCEL OSMF Consultant or OSMF Specialist Doctor.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Can MARCEL OraShield cure OSMF?",
            "answer": "<p>No cure claim is made. MARCEL OraShield is a supportive part of a broader OSMF care approach and does not replace professional diagnosis or treatment.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "What if I feel irritation or an unusual reaction?",
            "answer": "<p>Stop using the product and ask a qualified healthcare professional for advice. Follow the safety instructions on the product label.</p>"
          }
        }
      },
      "block_order": [
