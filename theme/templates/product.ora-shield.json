    "faq": {
      "type": "mt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is MARCEL Ora-Shield™?",
            "answer": "<p>MARCEL Ora-Shield™ is a therapeutic oral rinse and a key part of ADVANCE MARCEL OMR Therapy™. It is used as part of a care plan for OSMF, with guidance from a healthcare professional.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Who can use ADVANCE MARCEL OMR Therapy™?",
            "answer": "<p>It is for people with Stage 3 and Stage 4 OSMF. A MARCEL OSMF Consultant can help you understand which care approach may be suitable, and a qualified healthcare professional should confirm your stage.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How can MARCEL Ora-Shield™ help?",
            "answer": "<p>MARCEL Ora-Shield™ is part of a care plan for OSMF-related problems such as a burning feeling in the mouth, tightness inside the mouth and difficulty opening the mouth. Results may vary from person to person.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Can I use only MARCEL Ora-Shield™?",
            "answer": "<p>MARCEL Ora-Shield™ is one part of ADVANCE MARCEL OMR Therapy™. The complete routine includes:</p><ul><li>MARCEL Ora-Shield™ Therapeutic Oral Rinse</li><li>MARCEL Smile™ Toothpaste</li><li>Prescribed mouth and jaw exercises</li><li>Follow-up with your MARCEL OSMF Consultant</li></ul><p>Following only one part may leave your care routine incomplete. We recommend following the complete routine as advised by your consultant.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What if I feel irritation or an unusual reaction?",
            "answer": "<p>Stop using the product and ask a qualified healthcare professional for advice. Follow the safety instructions on the product label.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Where can I get professional guidance?",
            "answer": "<p><a href=\"/pages/osmf-consultant\" title=\"Talk to a MARCEL OSMF Consultant\">Talk to a MARCEL OSMF Consultant</a> to contact MARCEL. For a diagnosis or advice about your own care, please speak to a qualified OSMF Specialist doctor.</p>"
          }
        }
